---
// Page introductions sized to the task: 'editorial' for reading pages,
// 'tool' for pages where the visitor came to do something.
interface Props { title: string; lead?: string; kind?: 'editorial' | 'tool'; crumbs?: [string, string][]; eyebrow?: string; tone?: string; }
const { title, lead, kind = 'editorial', crumbs, eyebrow } = Astro.props;
---
<header class:list={['intro', kind]}>
  <div class="wrap">
    {crumbs && <nav aria-label="Breadcrumb" class="crumbs"><ol role="list">{crumbs.map(([l, h]) => <li><a href={h}>{l}</a></li>)}<li aria-current="page">{title}</li></ol></nav>}
    <div class="intro-grid">
      <div class="intro-copy">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1>{title}</h1>
        {lead && <p class="lead">{lead}</p>}
      </div>
      <div class="intro-aside"><slot /></div>
    </div>
  </div>
</header>
<style>
  .intro { background: var(--bg); }
  .intro.editorial { padding: clamp(56px, 7vw, 120px) 0 clamp(40px, 5vw, 80px); }
  .intro.tool { padding: clamp(32px, 4vw, 56px) 0 clamp(20px, 2.5vw, 32px); }
  .intro-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 32px 64px; align-items: end; }
  .intro-copy { display: grid; gap: 20px; }
  .editorial h1 { font-size: var(--t-3xl); max-width: 16ch; }
  .tool h1 { font-size: var(--t-2xl); max-width: 22ch; }
  .tool .lead { font-size: 1.125rem; }
  .intro-aside { min-width: 0; }
  .intro-aside:empty { display: none; }
  .intro-aside :global(.btn) { white-space: normal; }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 28px; font-size: var(--t-sm); color: var(--fg-2); }
  .crumbs li + li::before { content: "/"; margin-right: 6px; color: var(--fg-3); }
  .crumbs a { text-decoration: none; } .crumbs a:hover { text-decoration: underline; }
  @media (max-width: 860px) { .intro-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
