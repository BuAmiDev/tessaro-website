---
import Status from './Status.astro';
import Icon from './Icon.astro';
import { GROUPS, ROLE_NAMES, type Capability } from '../content/capabilities';
interface Props { c: Capability; }
const { c } = Astro.props;
---
<li class="cc" data-status={c.status}>
  <div class="cc-h"><h3>{c.name}</h3><Status status={c.status} /></div>
  <p>{c.outcome}</p>
  <p class="cc-ex xs">{c.example}</p>
  <p class="xs muted">{c.roles.map((r) => ROLE_NAMES[r]).join(' · ')}{c.ai && ' · Suggests or drafts; a person confirms'}</p>
  <div class="cc-a">
    {c.status !== 'proposed' && <button class="btn btn-sm" type="button" data-add={c.id} aria-pressed="false"><Icon name="plus" size={16} /><span>Add to my setup</span></button>}
    <a class="btn btn-sm btn-quiet" href={`/features#${c.id}`}>Details</a>
  </div>
</li>
<style>
  .cc { background: var(--surface-raised); border: 1px solid var(--line); border-radius: var(--r-md); padding: 20px; display: flex; flex-direction: column; gap: 10px; }
  .cc[data-status="proposed"] { background: transparent; border-style: dashed; }
  .cc-h { display: flex; justify-content: space-between; gap: 10px; align-items: flex-start; }
  .cc h3 { font-size: 1.1rem; line-height: 1.3; }
  .cc-ex { color: var(--fg-2); background: var(--surface); padding: 8px 10px; border-radius: 6px; }
  .cc-a { display: flex; gap: 8px; flex-wrap: wrap; margin-top: auto; }
  .cc-a .btn[aria-pressed="true"] { background: var(--surface-selected); border-color: var(--accent); color: var(--accent-text); }
</style>
