---
// A capability as an open row: what it does, an example, who uses it,
// what exists today and where to see it. Saving is the only control.
import Status from './Status.astro';
import { ROLE_NAMES, type Capability } from '../content/capabilities';
import { brand } from '../config/brand';
interface Props { c: Capability; }
const { c } = Astro.props;
---
<li class="cr" id={`cap-${c.id}`} data-status={c.status}>
  <div class="cr-h">
    <h3 class="cr-n">{c.name}</h3>
    <Status status={c.status} />
  </div>
  <div class="cr-b">
    <p>{c.outcome}</p>
    <p class="cr-ex">{c.example}</p>
    <p class="cr-m">{c.roles.map((r) => ROLE_NAMES[r]).join(' · ')}{c.ai && ' · suggests or drafts, a person confirms'}{c.evidence.length > 0 && <> · Screens {c.evidence.slice(0, 3).map((e, i) => <>{i > 0 && ', '}<a href={`${brand.productUrl}/#${e}`} target="_blank" rel="noopener">{e}</a></>)}</>}</p>
  </div>
  <div class="cr-a">
    {c.status !== 'proposed' ? <button class="btn btn-sm" type="button" data-add={c.id} aria-pressed="false"><span>Save to my setup</span></button> : <span class="small muted">Not yet available to save</span>}
  </div>
</li>
<style>
  .cr { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 6fr) auto; gap: 12px 40px; padding: 28px 0; border-top: 1px solid var(--line); align-items: start; }
  .cr-h { display: grid; gap: 8px; justify-items: start; }
  .cr-n { font-size: 1.375rem; }
  .cr-b { display: grid; gap: 8px; }
  .cr-ex { color: var(--fg-2); font-size: var(--t-sm); padding-left: 14px; border-left: 2px solid var(--line); }
  .cr-m { font-size: var(--t-sm); color: var(--fg-3); }
  .cr-m a { color: var(--fg-2); }
  .cr-a .btn[aria-pressed="true"] { background: var(--green-tint); --b-line: var(--green); color: var(--green); }
  @media (max-width: 900px) { .cr { grid-template-columns: 1fr; gap: 12px; } }
</style>
