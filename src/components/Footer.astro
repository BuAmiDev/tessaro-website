---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { brand } from '../config/brand';
const year = 2026;
const cols = [
  { t: 'Platform', l: [['Overview', '/platform'], ['Service intake', '/platform/intake'], ['Dispatch and scheduling', '/platform/coordination'], ['Technician app', '/platform/field'], ['Contracts and service levels', '/platform/contracts'], ['Configuration', '/platform/configuration']] },
  { t: 'Industries', l: [['HVAC and refrigeration', '/industries/hvac-refrigeration'], ['Property management', '/industries/property-management'], ['Facilities maintenance', '/industries/facilities-maintenance'], ['All industries', '/industries']] },
  { t: 'Evaluate', l: [['Interactive demo', '/simulator'], ['Feature explorer', '/features'], ['Configurator', '/configurator'], ['My setup', '/my-setup'], ['Pricing', '/pricing']] },
  { t: 'Help', l: [['Help center', '/help'], ['Contact support', '/support'], ['Book a demo', '/demo'], ['Start a trial', '/trial']] },
  { t: 'Company', l: [['About', '/company'], ['Privacy', '/legal/privacy'], ['Terms', '/legal/terms'], ['Product prototype', brand.productUrl]] },
];
---
<footer class="ftr" data-surface="dark">
  <div class="wrap">
    <div class="ftr-top">
      <div class="ftr-brand">
        <Logo tone="dark" height={28} />
        <p>Every operational piece, intelligently connected. Service work, teams, assets and decisions in one place.</p>
        <div class="ftr-contact">
          <a href={`mailto:${brand.supportEmail}`}><Icon name="mail" size={16} /> {brand.supportEmail}</a>
          <span><Icon name="phone" size={16} /> <span class="num" translate="no">{brand.phone}</span></span>
          <span><Icon name="map-pin" size={16} /> {brand.region}</span>
        </div>
      </div>
      <nav class="ftr-keys" aria-label="Footer">
        {cols.map((c) => (
          <div class="ftr-col">
            <p class="ftr-t">{c.t}</p>
            <ul role="list">{c.l.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
          </div>
        ))}
      </nav>
    </div>
    <div class="ftr-bottom">
      <p class="ftr-state"><span class="dot" aria-hidden="true"></span>Tessaro 2.0 is designed and being prepared for its first pilot release. Statuses on this site say what exists today.</p>
      <p>© {year} {brand.legalEntity}. {brand.name} is a working product name.</p>
    </div>
  </div>
</footer>

<style>
  .ftr { background: var(--graphite-950); color: var(--fg); padding: 72px 0 calc(28px + env(safe-area-inset-bottom, 0px)); --bg: var(--graphite-950); }
  .ftr-top { display: grid; grid-template-columns: minmax(240px, 1fr) 2.4fr; gap: 48px; padding-bottom: 48px; border-bottom: 1px solid var(--line); }
  .ftr-brand { display: grid; gap: 18px; align-content: start; }
  .ftr-brand p { color: var(--fg-2); max-width: 34ch; font-size: var(--t-sm); }
  .ftr-contact { display: grid; gap: 8px; font-size: var(--t-sm); color: var(--fg-2); }
  .ftr-contact a, .ftr-contact > span { display: inline-flex; gap: 8px; align-items: center; text-decoration: none; }
  .ftr-contact a:hover { color: var(--fg); }
  /* Link groups sit on a tile panel, the footer's nod to the mosaic and to physical control panels */
  .ftr-keys { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 3px; background: var(--line); border: 3px solid var(--line); border-radius: var(--r-xs); }
  .ftr-col { background: var(--graphite-900); border-radius: 6px; padding: 18px 16px 20px; }
  .ftr-t { font-size: var(--t-xs); font-weight: 600; color: var(--fg-3); margin-bottom: 10px; }
  .ftr-col ul { display: grid; gap: 2px; margin: 0; }
  .ftr-col a { display: block; padding: 5px 0; font-size: var(--t-sm); color: var(--fg-2); text-decoration: none; }
  .ftr-col a:hover { color: var(--fg); text-decoration: underline; }
  .ftr-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 32px; padding-top: 24px; font-size: var(--t-xs); color: var(--fg-3); }
  .ftr-state { display: flex; gap: 10px; align-items: center; max-width: 70ch; }
  .dot { width: 8px; height: 8px; border-radius: 2px; background: var(--wait); flex: 0 0 auto; }
  @media (max-width: 980px) { .ftr-top { grid-template-columns: 1fr; } .ftr-keys { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .ftr-keys { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
