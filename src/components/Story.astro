---
import { CHAPTERS, RECORD, STORY, ACTOR } from '../story/story-data';
import { FRAMES, CHAPTER_FRAME, FLOORS, APP_STEPS } from '../story/story-frames';
const first = CHAPTERS[0];
const still = (id: string) => `/story/v4/${id}-1024.webp`;
---
<section class="story" id="story" aria-labelledby="story-title" data-story data-mode="live">
  <div class="st-stage" data-stage>
    <!-- First frame of the 3D scene, rendered ahead of time; replaced by the live canvas once it is ready -->
    <picture class="st-poster" data-poster>
      <source media="(max-aspect-ratio: 5/6)" srcset="/story/3d/poster-p.webp" />
      <img src="/story/3d/poster-l.webp" alt="Harbour Point, a six-storey office building with bronze fins and limestone bands, in late-afternoon light." width="1600" height="900" fetchpriority="high" decoding="async" />
    </picture>
    <canvas class="st-canvas" data-canvas aria-hidden="true"></canvas>
    <!-- Fallback for devices without WebGL: rendered stills, one per chapter -->
    <div class="st-stills" data-stills aria-hidden="true"></div>

    <div class="st-scrim" aria-hidden="true"></div>
    <svg class="st-map" data-map aria-hidden="true">
      {FLOORS.map((f) => <polygon data-floor={f.id} points="" />)}
    </svg>

    <div class="st-open wrap" data-open>
      <h1 id="story-title" class="st-title">One intelligence across your spaces, assets and service operations.</h1>
      <p class="st-sub">Tessaro connects facilities, maintenance, field service and asset management, from the first sign of a fault to a verified record.</p>
      <div class="st-cta">
        <a class="btn btn-primary btn-lg" href="#story-start" data-explore>Explore the building</a>
        <a class="btn btn-lg" href="/demo">Book a demo</a>
      </div>
      <div class="st-pick" role="group" aria-labelledby="pick-l">
        <p class="pick-l" id="pick-l">Choose a floor</p>
        <div class="pick-b">
          {FLOORS.map((f) => <button type="button" data-pick={f.id} aria-pressed="false" aria-describedby="pick-note"><span class="sr">{f.name}</span><span aria-hidden="true">{f.id}</span></button>)}
        </div>
        <p class="pick-n" id="pick-note" aria-live="polite" data-pick-note>Level 4 is where this story happens.</p>
      </div>
    </div>

    <div class="st-anno" data-annos aria-hidden="true">
      {['a', 'b', 'c'].map((k) => <span class="an" data-an={k}></span>)}
    </div>

    <div class="st-cap wrap" data-cap>
      <div class="cap-in">
        <p class="cap-k"><span data-cap-n>01</span> · <span data-cap-time>{first.time}</span> <span class="cap-ill">Illustrative, compressed timeline</span></p>
        <p class="cap-l" data-cap-label aria-live="polite">{first.label}</p>
        <p class="cap-t" data-cap-text>{first.text}</p>
        <p class="cap-a"><span data-cap-actor>{ACTOR[first.actor]}</span><span class="cap-src" data-cap-src>{first.source}</span></p>
      </div>
    </div>

    <div class="st-rec" data-rec role="region" aria-label="Work record">
      <p class="rec-h"><span class="id">{STORY.wo}</span><span class="rec-s" data-rec-state>Not yet created</span></p>
      <p class="rec-asset"><b>{STORY.asset}</b> · {STORY.assetName}<br />{STORY.building} · {STORY.location}</p>
      <ol role="list" class="rec-list">
        {RECORD.map((r) => <li data-rec-row={r.id} data-at={r.at}><span class="rec-l">{r.label}</span><span class="rec-v">{r.value}</span></li>)}
      </ol>
      <dl class="rec-read" data-read>
        <div><dt>Supply air</dt><dd data-read-supply>14.0 °C</dd></div>
        <div><dt>Valve cmd · pos</dt><dd data-read-valve>100% · 99%</dd></div>
        <div><dt>Room 4.07</dt><dd data-read-room>23.1 °C</dd></div>
      </dl>
    </div>

    <!-- App view: the product interface alone, on a floating glass surface -->
    <div class="st-app" data-app inert>
      <button type="button" class="app-glass" data-app-open aria-label="Enlarge this screen">
        <img data-app-img alt="" width="360" height="760" decoding="async" />
      </button>
    </div>

    <nav class="st-nav" aria-label="Story chapters" data-nav>
      <ol role="list">
        {CHAPTERS.map((c, i) => <li><button type="button" data-ch={i}><span class="n">{String(i + 1).padStart(2, '0')}</span><span class="t">{c.nav}</span></button></li>)}
      </ol>
      <div class="st-ctl">
        <button type="button" data-prev class="ctl" aria-label="Previous chapter">‹</button>
        <button type="button" data-next class="ctl" aria-label="Next chapter">›</button>
        <button type="button" data-replay class="ctl-t">Replay</button>
        <a href="#story-overview" data-overview class="ctl-t">Overview</a>
        <a href="#after-story" class="ctl-t">Skip story</a>
      </div>
      <div class="st-prog" aria-hidden="true"><i data-prog></i></div>
    </nav>
  </div>
  <span id="story-start" class="st-start" aria-hidden="true"></span>
  <dialog class="st-zoom" data-zoom aria-label="Product screen">
    <img data-zoom-img alt="" width="360" height="760" />
    <form method="dialog"><button class="btn btn-sm">Close</button></form>
  </dialog>
</section>

<section class="st-over section tight" id="story-overview" aria-labelledby="ov-title">
  <div class="wrap">
    <div class="ov-head">
      <h2 id="ov-title" class="h3">The story at a glance</h2>
      <p class="muted">One illustrative fault at Harbour Point, a fictional building. The walkthrough above is a real-time 3D scene; the pictures here are rendered stills of the same places. Readings, names and times are sample data on a compressed timeline. App screens are designed Tessaro screens shown with sample data. The connection to a building management system is proposed, not yet built.</p>
    </div>
    <ol role="list" class="ov-list">
      {CHAPTERS.map((c, i) => {
        const f = FRAMES[CHAPTER_FRAME[i]];
        return (
          <li>
            <img src={still(f.id)} alt="" width="1024" height="579" loading="lazy" decoding="async" style={`object-position:${i === 3 ? '54% 30%' : `${f.focus[0] * 100}% ${f.focus[1] * 100}%`}`} />
            <div><p class="ov-k">{String(i + 1).padStart(2, '0')} · {c.time} · {ACTOR[c.actor]}</p><h3 class="ov-l">{c.label}</h3><p>{c.text}</p></div>
          </li>
        );
      })}
    </ol>
  </div>
</section>
<span id="after-story"></span>

<script type="application/json" data-app-steps set:html={JSON.stringify(APP_STEPS)} />
<script type="application/json" data-stills-list set:html={JSON.stringify(CHAPTER_FRAME.map((id) => still(id)))} />

<style>
  .story { position: relative; height: 680vh; background: #E9E6DF; --rx: max(20px, calc((100vw - var(--page-max)) / 2)); }
  .story[data-mode="static"], .story[data-mode="stills"] { height: auto; }
  .st-stage { position: sticky; top: var(--hdr-h); height: calc(100vh - var(--hdr-h)); height: calc(100svh - var(--hdr-h)); overflow: hidden; }
  .story[data-mode="static"] .st-stage, .story[data-mode="stills"] .st-stage { position: relative; top: 0; height: min(calc(100svh - var(--hdr-h)), 880px); min-height: 640px; }
  .st-start { position: absolute; top: 60vh; }
  .st-poster img, .st-canvas, .st-stills, .st-stills :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .st-canvas { opacity: 0; transition: opacity 500ms var(--ease-out); }
  .story.live .st-canvas { opacity: 1; }
  .story.live .st-poster { visibility: hidden; transition: visibility 0s 520ms; }
  .st-stills :global(img) { opacity: 0; } .st-stills :global(img.on) { opacity: 1; }

  /* floor picker: polygons projected from the 3D floors every frame */
  .st-map { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; opacity: 0; transition: opacity 300ms var(--ease-out); }
  .story.pick-on .st-map { opacity: 1; }
  .story.pick-on .st-map polygon { pointer-events: auto; cursor: pointer; }
  .st-map polygon { fill: rgba(247, 247, 244, 0); stroke: rgba(247, 247, 244, 0); stroke-width: 2; transition: fill 220ms ease, stroke 220ms ease; }
  .st-map polygon.hover { fill: rgba(247, 247, 244, .2); stroke: rgba(247, 247, 244, .9); }
  .st-map polygon.sel { fill: rgba(36, 91, 70, .32); stroke: #E8EFEB; }

  .st-open { position: absolute; left: 0; right: 0; top: clamp(28px, 6vh, 72px); display: grid; gap: 22px; justify-items: start; transition: opacity 400ms var(--ease-out), transform 400ms var(--ease-out); }
  .st-title { font-size: clamp(2.6rem, 1rem + 4.1vw, 5.4rem); line-height: .98; letter-spacing: -0.048em; font-weight: 540; max-width: 12ch; color: var(--ink); }
  .st-scrim { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, rgba(233,230,223,.94) 0%, rgba(233,230,223,.8) 28%, rgba(233,230,223,.3) 46%, rgba(233,230,223,0) 60%); transition: opacity 400ms var(--ease-out); }
  .story.past-open .st-scrim { opacity: 0; }
  .st-sub { font-size: var(--t-lg); line-height: 1.45; color: var(--ink-2); max-width: 40ch; }
  .st-cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 6px; }
  .story.past-open .st-open { opacity: 0; transform: translateY(-24px); pointer-events: none; }
  .st-pick { display: grid; gap: 8px; margin-top: 8px; padding: 14px 16px; background: rgba(247, 247, 244, .9); border-radius: var(--r-md); box-shadow: var(--e-float); max-width: 380px; }
  .pick-l { font-size: var(--t-sm); font-weight: 600; color: var(--ink); }
  .pick-b { display: flex; gap: 6px; flex-wrap: wrap; }
  .pick-b button { min-width: 44px; height: 40px; padding: 0 10px; border-radius: var(--r-sm); border: 1px solid var(--line-c2); background: var(--white); font: 600 var(--t-sm)/1 var(--font-body); color: var(--ink); cursor: pointer; font-variant-numeric: tabular-nums; }
  .pick-b button:hover, .pick-b button.hover { border-color: var(--ink); }
  .pick-b button[aria-pressed="true"] { background: var(--green); border-color: var(--green); color: #fff; }
  .pick-b button[data-pick="L4"]:not([aria-pressed="true"]) { box-shadow: inset 0 -2px 0 var(--green); }
  .pick-n { font-size: var(--t-sm); color: var(--ink-2); min-height: 2.9em; line-height: 1.45; }
  .pick-n :global(a) { color: var(--green); font-weight: 600; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .st-cap { position: absolute; left: 0; right: 0; bottom: 112px; pointer-events: none; opacity: 0; transition: opacity 300ms ease; }
  .story.past-open .st-cap { opacity: 1; }
  .cap-in { max-width: 500px; background: rgba(247, 247, 244, .95); padding: 22px 24px; border-radius: var(--r-md); box-shadow: var(--e-float); pointer-events: none; }
  .story.past-open .cap-in { pointer-events: auto; }
  .cap-k { font-size: var(--t-sm); color: var(--ink-3); font-variant-numeric: tabular-nums; display: flex; flex-wrap: wrap; gap: 4px 6px; }
  .cap-ill { font-style: italic; }
  .cap-l { font-family: var(--font-display); font-size: clamp(1.6rem, 1.1rem + 1.6vw, 2.4rem); letter-spacing: -0.035em; line-height: 1.05; margin: 8px 0 10px; font-weight: 560; color: var(--ink); }
  .cap-t { color: var(--ink-2); font-size: 1.0625rem; line-height: 1.55; }
  .cap-a { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: var(--t-sm); font-weight: 600; color: var(--green); }
  .cap-src { color: var(--ink-3); font-weight: 500; }

  .st-rec { position: absolute; right: var(--rx); top: 24px; width: 316px; background: rgba(255, 255, 255, .96); border-radius: var(--r-md); box-shadow: var(--e-float); padding: 16px 18px 12px; font-size: var(--t-sm); opacity: 0; transform: translateY(8px); transition: opacity 300ms ease, transform 400ms var(--ease-out); pointer-events: none; }
  .story.rec-on .st-rec { opacity: 1; transform: none; pointer-events: auto; }
  .story.app-on .st-rec { opacity: 0; pointer-events: none; }
  .rec-h { display: flex; justify-content: space-between; gap: 8px; align-items: baseline; }
  .rec-h .id { font-weight: 650; }
  .rec-s { color: var(--ink-3); font-size: var(--t-xs); }
  .rec-asset { color: var(--ink-2); margin: 6px 0 10px; line-height: 1.45; }
  .rec-asset b { color: var(--ink); }
  .rec-list { margin: 0; display: grid; gap: 0; border-top: 1px solid var(--line-c); }
  .rec-list li { display: grid; grid-template-columns: 16px 1fr; gap: 0 10px; padding: 6px 0; border-bottom: 1px solid var(--line-c); color: var(--ink-3); transition: color 250ms ease; }
  .rec-list li::before { content: ""; grid-row: span 2; width: 10px; height: 10px; margin-top: 5px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px var(--line-c2); transition: background-color 250ms ease, box-shadow 250ms ease, transform 300ms var(--ease-out); }
  .rec-list li.done { color: var(--ink); }
  .rec-list li.done::before { background: var(--green); box-shadow: none; }
  .rec-list li.now::before { transform: scale(1.35); }
  .rec-l { font-weight: 600; }
  .rec-v { font-size: var(--t-xs); color: var(--ink-2); line-height: 1.4; display: none; }
  .rec-list li.now .rec-v { display: block; }
  .rec-read { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 10px 0 0; }
  .rec-read div { display: grid; gap: 2px; }
  .rec-read dt { font-size: 11px; color: var(--ink-3); }
  .rec-read dd { margin: 0; font-weight: 650; font-variant-numeric: tabular-nums; font-size: 13.5px; }
  .rec-read[data-tone="alert"] dd { color: var(--alert); }
  .rec-read[data-tone="ok"] dd { color: var(--ok); }

  /* app view: frameless floating glass; the interface keeps its own crisp cards */
  .st-app { position: absolute; right: calc(var(--rx) + 24px); top: 22px; perspective: 1400px; opacity: 0; pointer-events: none; transition: opacity 360ms ease; }
  .story.app-on .st-app { opacity: 1; pointer-events: auto; }
  .app-glass { display: block; position: relative; padding: 0; border: 0; border-radius: 30px; cursor: zoom-in; overflow: hidden;
    transform: rotateY(-7deg) rotateX(2deg) translateY(16px); transform-origin: 70% 50%; transition: transform 700ms var(--ease-out);
    background: linear-gradient(155deg, rgba(255,255,255,.22), rgba(232,242,236,.10) 45%, rgba(255,255,255,.16));
    -webkit-backdrop-filter: blur(10px) saturate(140%); backdrop-filter: blur(10px) saturate(140%);
    box-shadow: 0 40px 80px -40px rgba(20, 30, 25, .55), 0 2px 8px -3px rgba(20, 30, 25, .18); }
  .story.app-on .app-glass { transform: rotateY(-7deg) rotateX(2deg) translateY(0); animation: st-float 7s ease-in-out 700ms infinite; }
  .app-glass::after { content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.55), inset 0 1px 0 rgba(255,255,255,.9);
    background: linear-gradient(115deg, rgba(255,255,255,.28) 0%, rgba(255,255,255,0) 22%, rgba(255,255,255,0) 78%, rgba(255,255,255,.12) 100%); }
  @keyframes st-float { 0%, 100% { transform: rotateY(-7deg) rotateX(2deg) translateY(0); } 50% { transform: rotateY(-6deg) rotateX(1.6deg) translateY(-4px); } }
  .app-glass img { display: block; height: min(640px, calc(100svh - var(--hdr-h) - 150px)); width: auto; aspect-ratio: 360 / 760; transition: opacity 220ms ease; }
  .app-glass img.swap { opacity: 0; }
  .app-glass:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { .app-glass, .story.app-on .app-glass { animation: none; transition: none; transform: none; } }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) { .app-glass { background: rgba(244, 247, 245, .85); } }
  .st-zoom { border: 0; padding: 16px; border-radius: var(--r-lg); background: #EEF2EF; max-height: 94vh; }
  .st-zoom::backdrop { background: rgba(32, 37, 34, .6); }
  .st-zoom img { display: block; height: min(760px, calc(94vh - 90px)); width: auto; }
  .st-zoom form { display: flex; justify-content: center; margin-top: 12px; }

  .st-anno { position: absolute; inset: 0; pointer-events: none; }
  .an { position: absolute; left: 0; top: 0; display: none; background: var(--ink); color: #fff; font-size: 13px; font-weight: 600; padding: 7px 10px; border-radius: 6px; white-space: nowrap; line-height: 1.3; box-shadow: 0 8px 20px -10px rgba(0,0,0,.5); }
  .an::after { content: ""; position: absolute; left: var(--ax, 50%); bottom: -14px; width: 1px; height: 14px; background: inherit; }
  .an::before { content: ""; position: absolute; left: calc(var(--ax, 50%) - 4px); bottom: -18px; width: 9px; height: 9px; border-radius: 50%; background: inherit; box-shadow: 0 0 0 2px rgba(255,255,255,.8); }
  .an.on { display: block; }
  .an.alert { background: #8F2A20; }
  .an.ok { background: var(--green); }

  .st-nav { position: absolute; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 8px 24px; padding: 14px var(--rx) 18px; background: linear-gradient(to top, rgba(247,247,244,.98) 55%, rgba(247,247,244,0)); }
  .st-nav ol { display: flex; gap: 2px; margin: 0; overflow-x: auto; scrollbar-width: none; }
  .st-nav button[data-ch] { display: inline-flex; gap: 8px; align-items: baseline; padding: 10px 12px; border: 0; background: none; color: var(--ink-3); font-size: var(--t-sm); font-weight: 560; cursor: pointer; border-radius: var(--r-sm); white-space: nowrap; transition: color var(--d-fast) ease; }
  .st-nav button[data-ch] .n { font-size: 11px; font-variant-numeric: tabular-nums; }
  .st-nav button[data-ch]:hover { color: var(--ink); }
  .st-nav button[aria-current="step"] { color: var(--ink); }
  .st-nav button[aria-current="step"] .t { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1.5px; }
  .st-ctl { display: flex; gap: 4px 14px; align-items: center; }
  .ctl { width: 40px; height: 40px; border-radius: var(--r-sm); border: 1px solid var(--line-c2); background: var(--white); font-size: 20px; line-height: 1; cursor: pointer; color: var(--ink); }
  .ctl:hover { border-color: var(--ink); }
  .ctl-t { background: none; border: 0; padding: 8px 2px; font-size: var(--t-sm); font-weight: 560; color: var(--ink-2); cursor: pointer; text-decoration: underline; text-decoration-color: rgba(32,37,34,.3); text-underline-offset: 4px; }
  .ctl-t:hover { color: var(--ink); text-decoration-color: currentColor; }
  .st-prog { grid-column: 1 / -1; height: 2px; background: var(--line-c); }
  .st-prog i { display: block; height: 100%; width: 0; background: var(--ink); }
  .story[data-mode="live"] [data-prev], .story[data-mode="live"] [data-next] { display: none; }

  .st-over { background: var(--chalk); }
  .ov-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 24px 64px; align-items: end; margin-bottom: 48px; }
  .ov-head p { max-width: 64ch; font-size: var(--t-sm); }
  .ov-list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 40px 24px; margin: 0; }
  .ov-list li { display: grid; gap: 14px; align-content: start; }
  .ov-list img { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--r-sm); background: #E6E8E2; }
  .ov-k { font-size: var(--t-xs); color: var(--ink-3); }
  .ov-l { font-size: 1.25rem; margin: 4px 0 6px; }
  .ov-list p:not(.ov-k) { font-size: var(--t-sm); color: var(--ink-2); line-height: 1.55; }

  @media (max-width: 1100px) { .ov-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 900px) {
    .st-rec { left: 20px; right: auto; top: 12px; width: min(300px, calc(100vw - 40px)); padding: 12px 14px; }
    .rec-asset, .rec-read { display: none; }
    .rec-list li:not(.now) { display: none; }
    .st-cap { bottom: 104px; }
    .cap-in { padding: 16px 18px; }
    .cap-t { font-size: 1rem; }
    .st-nav button[data-ch] .t { display: none; }
    .st-nav button[aria-current="step"] .t { display: inline; }
    .st-nav { grid-template-columns: 1fr; }
    .ov-head { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .st-scrim { display: none; }
    .st-open { top: 0; padding-top: 24px; padding-bottom: 40px; gap: 16px; background: linear-gradient(to bottom, rgba(233,230,223,.96) 72%, rgba(233,230,223,0)); }
    .st-sub { font-size: 1.0625rem; }
    .st-pick { padding: 10px 12px; box-shadow: none; background: rgba(247,247,244,.7); }
    .st-app { left: 50%; right: auto; top: 12px; transform: translateX(-50%); }
    .app-glass { border-radius: 24px; }
    .app-glass img { height: auto; width: min(250px, 66vw); max-height: calc(100svh - var(--hdr-h) - 250px); object-fit: cover; object-position: top; }
    .story.app-on .cap-t, .story.app-on .cap-a { display: none; }
    .story.app-on .cap-l { font-size: 1.35rem; margin-bottom: 0; }
  }
  @media (max-width: 560px) {
    .ov-list { grid-template-columns: 1fr; } .cap-src { display: none; } .st-sub { display: none; }
    .st-title { max-width: none; font-size: clamp(1.9rem, 8.2vw, 2.6rem); }
    .st-open { padding-bottom: 12px; gap: 12px; background: linear-gradient(to bottom, rgba(233,230,223,.96) 85%, rgba(233,230,223,0)); }
    .st-cta { flex-wrap: nowrap; gap: 8px; margin-top: 0; }
    .st-cta .btn { padding-inline: 14px; min-height: 44px; font-size: var(--t-sm); }
    .st-pick { margin-top: 0; gap: 6px; justify-self: stretch; max-width: none; }
    .pick-b { flex-wrap: nowrap; gap: 4px; } .pick-b button { min-width: 0; flex: 1; height: 38px; padding: 0 4px; }
    .story:not(.picked) .pick-n { display: none; }
    .pick-n { min-height: 0; }
  }
  @media (max-width: 760px) and (max-height: 700px) { .st-sub { display: none; } }
  @media (min-width: 761px) and (max-height: 820px) { .st-open { top: 22px; gap: 14px; } .st-title { font-size: clamp(2.4rem, 1rem + 3.3vw, 4.3rem); } .st-sub { font-size: 1.05rem; } .st-pick { padding: 10px 14px; gap: 6px; } .pick-n { min-height: 0; } .story:not(.picked) .pick-n { display: none; } }
</style>

<script>
  import { CHAPTERS, RECORD, ACTOR, chapterAt, readingsAt } from '../story/story-data';
  import { FLOORS, type AppStep } from '../story/story-frames';
  import { brand } from '../config/brand';
  const root = document.querySelector<HTMLElement>('[data-story]')!;
  const q = new URLSearchParams(location.search);
  const stillParam = q.get('story-still');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const webgl = (() => { try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; } })();
  const forced = q.get('story-mode') as 'live' | 'static' | 'stills' | null;
  const mode: 'live' | 'static' | 'stills' = forced || (!webgl ? 'stills' : reduce && !stillParam ? 'static' : 'live');
  root.dataset.mode = mode;
  const STEPS: AppStep[] = JSON.parse(document.querySelector('[data-app-steps]')!.textContent!);
  if (stillParam && q.get('story-clean')) document.documentElement.classList.add('story-still');
  const STILLS: string[] = JSON.parse(document.querySelector('[data-stills-list]')!.textContent!);

  const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const stage = $('[data-stage]'), canvas = $<HTMLCanvasElement>('[data-canvas]');
  const navBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-ch]')];
  const recRows = [...root.querySelectorAll<HTMLElement>('[data-rec-row]')];
  const annoEls = [...root.querySelectorAll<HTMLElement>('[data-an]')];
  const pickBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-pick]')];
  const polys = [...root.querySelectorAll<SVGPolygonElement>('[data-floor]')];
  let scene: import('../story/scene').StoryScene | null = null;
  let p = 0, staticP = CHAPTERS[0].still, lastCh = -1, raf = 0, picked = '', hovered = '';

  const hdrH = () => parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--hdr-h')) || 0;
  const span = () => root.offsetHeight - (innerHeight - hdrH());
  const topY = () => root.getBoundingClientRect().top + scrollY - hdrH();
  function progress() {
    if (stillParam) return parseFloat(stillParam);
    if (mode !== 'live') return staticP;
    return Math.min(1, Math.max(0, (scrollY - topY()) / Math.max(1, span())));
  }

  // ----- travel: chapter jumps move along the same camera path -----
  let tween = 0;
  const cancelTween = () => { if (tween) { cancelAnimationFrame(tween); tween = 0; } };
  ['wheel', 'touchstart', 'keydown', 'mousedown'].forEach((ev) => addEventListener(ev, (e) => { if (ev === 'mousedown' && (e.target as HTMLElement).closest('[data-ch],[data-pick],[data-explore],[data-replay],[data-floor]')) return; cancelTween(); }, { passive: true }));
  function travelTo(target: number) {
    if (mode !== 'live') { staticP = target; request(); return; }
    cancelTween();
    const from = progress(), d = Math.abs(target - from); if (d < .001) return;
    const dur = Math.min(4200, 900 + 3600 * d), t0 = performance.now(), y0 = topY();
    const ease = (t: number) => t < .5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    let el = 0, last = t0;
    // advance at most 60 ms per frame, so a slow frame slows the move instead of skipping it
    const step = () => { const now = performance.now(); el += Math.min(60, now - last); last = now; const t = Math.min(1, el / dur); scrollTo(0, y0 + (from + (target - from) * ease(t)) * span()); tween = t < 1 ? requestAnimationFrame(step) : 0; };
    tween = requestAnimationFrame(step);
  }

  // ----- floor picker -----
  function showFloors(autoPick: string) {
    const sel = picked || autoPick;
    polys.forEach((pl) => { pl.classList.toggle('hover', pl.dataset.floor === hovered && hovered !== sel); pl.classList.toggle('sel', pl.dataset.floor === sel); });
    pickBtns.forEach((b) => { b.setAttribute('aria-pressed', String(b.dataset.pick === sel)); b.classList.toggle('hover', b.dataset.pick === hovered); });
  }
  function note(id: string) {
    const f = FLOORS.find((x) => x.id === id); const n = $('[data-pick-note]');
    if (!f) { n.textContent = 'Level 4 is where this story happens.'; return; }
    n.innerHTML = `<b>${f.name}</b> · ${f.use}. ${f.note}.` + (f.story ? '' : ' <a href="#story-start" data-follow>Follow Level 4</a>');
  }
  function choose(id: string) {
    picked = id; root.classList.add('picked'); note(id); showFloors('');
    if (FLOORS.find((f) => f.id === id)?.story) setTimeout(() => travelTo(mode === 'live' ? .215 : CHAPTERS[1].still), reduce ? 0 : 250);
  }
  pickBtns.forEach((b) => {
    b.addEventListener('click', () => choose(b.dataset.pick!));
    b.addEventListener('mouseenter', () => { hovered = b.dataset.pick!; showFloors(''); });
    b.addEventListener('focus', () => { hovered = b.dataset.pick!; showFloors(''); if (!picked) note(hovered); });
    b.addEventListener('mouseleave', () => { hovered = ''; showFloors(''); });
    b.addEventListener('blur', () => { hovered = ''; showFloors(''); });
  });
  polys.forEach((pl) => {
    pl.addEventListener('pointerenter', () => { hovered = pl.dataset.floor!; showFloors(''); if (!picked) note(hovered); });
    pl.addEventListener('pointerleave', () => { hovered = ''; showFloors(''); if (!picked) note(''); });
    pl.addEventListener('click', () => choose(pl.dataset.floor!));
  });
  $('[data-pick-note]').addEventListener('click', (e) => { if ((e.target as HTMLElement).matches('[data-follow]')) { e.preventDefault(); choose('L4'); } });

  // ----- annotations attached to 3D points -----
  type Anno = { at: string; from: number; to: number; text: (p: number) => string; tone?: string };
  const ANNO: Anno[] = [
    { at: 'room', from: .13, to: .2, text: () => 'Level 4 · Room 4.07' },
    { at: 'room', from: .2, to: .27, text: () => 'Room 4.07 · 26.9 °C, setpoint 23 °C', tone: 'alert' },
    { at: 'valve', from: .3, to: .53, text: () => 'Valve actuator · 12% of 100% command', tone: 'alert' },
    { at: 'supply', from: .32, to: .53, text: () => 'Supply air · 21.6 °C, design 14 °C', tone: 'alert' },
    { at: 'tag', from: .41, to: .53, text: () => 'FCU-L4-07 · covered · out of warranty' },
    { at: 'desk', from: .6, to: .67, text: (p) => p < .615 ? 'Lina K. · same event, WO-2611-0418' : 'Rami S. assigned · confirmed by Lina' },
    { at: 'tech', from: .705, to: .77, text: () => 'Rami S. · 15:12 · actuator from van stock' },
    { at: 'tech', from: .82, to: .885, text: (p) => p < .855 ? 'FCU-L4-07 · replacing the actuator' : 'Actuator replaced · 2 photos' },
    { at: 'valve', from: .885, to: .93, text: () => 'New actuator · follows command, 98%', tone: 'ok' },
    { at: 'site', from: .955, to: 1.01, text: () => 'Harbour Point · record complete' },
  ];
  const visRect = (el: HTMLElement) => { const r = el.getBoundingClientRect(); const s = stage.getBoundingClientRect(); return { l: r.left - s.left, t: r.top - s.top, r: r.right - s.left, b: r.bottom - s.top }; };
  function blockers() {
    const out = [] as ReturnType<typeof visRect>[];
    if (root.classList.contains('app-on')) out.push(visRect($('.app-glass')));
    else if (root.classList.contains('rec-on')) out.push(visRect($('[data-rec]')));
    if (root.classList.contains('past-open')) out.push(visRect($('.cap-in')));
    out.push(visRect($('[data-nav]')));
    return out;
  }
  function placeAnnos(p: number, anchors: { id: string; x: number; y: number; visible: boolean }[]) {
    const at = Object.fromEntries(anchors.map((a) => [a.id, a]));
    const active = ANNO.filter((a) => p >= a.from && p < a.to);
    const blk = blockers(); const W = stage.clientWidth;
    annoEls.forEach((el, i) => {
      const a = active[i]; const pt = a && at[a.at];
      if (!a || !pt || !pt.visible) { el.classList.remove('on'); return; }
      el.textContent = a.text(p); el.className = 'an on ' + (a.tone || '');
      const w = el.offsetWidth, h = el.offsetHeight;
      const tries = [w / 2, w - 18, 18].map((ax) => ({ ax, l: pt.x - ax, t: pt.y - h - 18 }));
      const hit = (c: { l: number; t: number }) => c.l < 4 || c.l + w > W - 4 || c.t < 4 || blk.some((b) => !(c.l + w < b.l || c.l > b.r || c.t + h + 18 < b.t || c.t > b.b));
      const pos = tries.find((c) => !hit(c)); const onPoint = blk.some((b) => pt.x > b.l && pt.x < b.r && pt.y > b.t && pt.y < b.b);
      if (!pos || onPoint) { el.classList.remove('on'); return; }
      el.style.setProperty('--ax', `${pos.ax}px`); el.style.transform = `translate(${pos.l}px, ${pos.t}px)`;
    });
  }

  // ----- app views -----
  const appImg = $<HTMLImageElement>('[data-app-img]'); let appKey = '';
  function paintApp(p: number) {
    const s = STEPS.find((x) => p >= x.from && p < x.to);
    const wasOn = root.classList.contains('app-on') && !!appImg.getAttribute('src');
    root.classList.toggle('app-on', !!s); $('[data-app]').toggleAttribute('inert', !s);
    if (p > .5) STEPS.forEach((x) => { const i = new Image(); i.src = `/apps/glass-${x.img}.webp`; });
    if (!s || s.img === appKey) return;
    appKey = s.img;
    const set = () => { appImg.src = `/apps/glass-${s.img}.webp`; appImg.alt = `${s.app}, designed screen with sample data: ${s.caption}`; appImg.classList.remove('swap'); };
    if (reduce || !wasOn) set(); else { appImg.classList.add('swap'); setTimeout(set, 160); }
  }
  const zoom = root.querySelector<HTMLDialogElement>('[data-zoom]')!;
  $('[data-app-open]').addEventListener('click', () => { const z = zoom.querySelector<HTMLImageElement>('[data-zoom-img]')!; z.src = appImg.src; z.alt = appImg.alt; zoom.showModal(); });
  zoom.addEventListener('click', (e) => { if (e.target === zoom) zoom.close(); });

  // ----- state derived from p -----
  function paint(p: number) {
    const ci = chapterAt(p); const c = CHAPTERS[ci];
    root.classList.toggle('past-open', mode === 'live' ? p > .04 : ci > 0);
    root.classList.toggle('pick-on', p < .125);
    root.classList.toggle('rec-on', p > .26);
    if (ci !== lastCh) {
      lastCh = ci;
      $('[data-cap-n]').textContent = String(ci + 1).padStart(2, '0');
      $('[data-cap-time]').textContent = c.time; $('[data-cap-label]').textContent = c.label;
      $('[data-cap-text]').textContent = c.text; $('[data-cap-actor]').textContent = ACTOR[c.actor]; $('[data-cap-src]').textContent = c.source || '';
      navBtns.forEach((b, i) => { if (i === ci) b.setAttribute('aria-current', 'step'); else b.removeAttribute('aria-current'); });
      if (mode === 'stills') showStill(ci);
    }
    let last = -1; recRows.forEach((r, i) => { const done = p >= Number(r.dataset.at); r.classList.toggle('done', done); if (done) last = i; });
    recRows.forEach((r, i) => r.classList.toggle('now', i === Math.max(0, last)));
    const id = last >= 0 ? RECORD[last].id : '';
    $('[data-rec-state]').textContent = !id ? 'Not yet created' : id === 'close' ? 'Closed' : id === 'signoff' ? 'Signed off' : id === 'verify' ? 'Awaiting sign-off' : id === 'repair' ? 'Awaiting verification' : ['assign', 'update'].includes(id) ? 'Assigned' : 'Open';
    const rd = readingsAt(p); const box = $('[data-read]'); box.dataset.tone = rd.tone;
    $('[data-read-supply]').textContent = rd.supply; $('[data-read-valve]').textContent = rd.valve; $('[data-read-room]').textContent = rd.room;
    $<HTMLElement>('[data-prog]').style.width = `${p * 100}%`;
    paintApp(p);
    showFloors(p > .09 ? 'L4' : '');
  }

  function frame() {
    raf = 0; p = progress(); paint(p);
    if (scene) {
      const f = scene.render(p);
      f.floors.forEach((fl, i) => { polys[i].setAttribute('points', fl.visible ? fl.points : ''); });
      placeAnnos(p, f.anchors);
    }
  }
  const request = () => { if (!raf) raf = requestAnimationFrame(frame); };

  // ----- stills fallback (no WebGL) -----
  let stillsMade = false;
  function showStill(ci: number) {
    const host = $('[data-stills]');
    if (!stillsMade) { stillsMade = true; host.innerHTML = STILLS.map((s, i) => `<img alt="" decoding="async" ${i > 1 ? 'loading="lazy"' : ''} src="${s}" />`).join(''); }
    [...host.children].forEach((img, i) => img.classList.toggle('on', i === ci));
  }

  // ----- controls -----
  navBtns.forEach((b, i) => b.addEventListener('click', () => travelTo(mode === 'live' ? (i === 0 ? 0 : CHAPTERS[i].at + .012) : CHAPTERS[i].still)));
  const step = (d: number) => { const ci = chapterAt(progress()); const n = Math.min(CHAPTERS.length - 1, Math.max(0, ci + d)); travelTo(mode === 'live' ? CHAPTERS[n].at + .012 : CHAPTERS[n].still); };
  $('[data-prev]').addEventListener('click', () => step(-1));
  $('[data-next]').addEventListener('click', () => step(1));
  $('[data-replay]').addEventListener('click', () => { picked = ''; root.classList.remove('picked'); note(''); travelTo(mode === 'live' ? 0 : CHAPTERS[0].still); });
  $('[data-explore]').addEventListener('click', (e) => { e.preventDefault(); choose('L4'); });
  root.addEventListener('keydown', (e) => { if (mode !== 'live' && (e.key === 'ArrowRight' || e.key === 'ArrowLeft') && (e.target as HTMLElement).closest('[data-nav]')) { e.preventDefault(); step(e.key === 'ArrowRight' ? 1 : -1); } });

  // ----- boot -----
  async function boot() {
    const { createStoryScene } = await import('../story/scene');
    const narrow = matchMedia('(max-width: 760px)').matches;
    const lowPower = ((navigator as any).hardwareConcurrency || 8) <= 4 || (navigator as any).connection?.saveData === true;
    const qq = q.get('story-quality') as 'high' | 'low' | null;
    scene = createStoryScene(canvas, qq || (narrow || lowPower ? 'low' : 'high'));
    new ResizeObserver(() => { scene!.resize(); request(); }).observe(canvas);
    await scene.ready; frame();
    requestAnimationFrame(() => { root.classList.add('live'); document.documentElement.dataset.storyReady = '1'; });
  }
  addEventListener('scroll', request, { passive: true });
  addEventListener('resize', request);
  if (mode === 'stills') { showStill(0); frame(); }
  else { frame(); if (stillParam || document.readyState === 'complete') boot(); else addEventListener('load', () => boot(), { once: true }); }
</script>
<style is:global>
  html.story-still .hdr, html.story-still .st-open, html.story-still .st-cap, html.story-still .st-rec, html.story-still .st-nav, html.story-still .st-anno, html.story-still .st-app, html.story-still .st-scrim, html.story-still .st-map { visibility: hidden !important; }
</style>
