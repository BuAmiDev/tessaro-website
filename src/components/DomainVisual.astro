---
// A single architectural section drawing shared by the four domains.
// Each domain is a layer; selecting a domain brings its layer forward.
interface Props { active?: string; }
const { active = '' } = Astro.props;
---
<svg class="dv" data-active={active || undefined} viewBox="0 0 720 520" role="img" aria-label="Section through Harbour Point showing floors and rooms, equipment, maintenance work and a technician’s route, all attached to one record." data-dv>
  <defs>
    <pattern id="dv-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="6" stroke="currentColor" stroke-width=".6" opacity=".25" /></pattern>
  </defs>
  <!-- ground and structure (always visible) -->
  <g class="dv-base" fill="none" stroke="currentColor">
    <line x1="20" y1="440" x2="700" y2="440" stroke-width="1.5" />
    <rect x="20" y="440" width="680" height="40" fill="url(#dv-hatch)" stroke="none" />
    <g stroke-width="1.6">
      <rect x="150" y="120" width="380" height="320" />
      <line x1="150" y1="184" x2="530" y2="184" /><line x1="150" y1="248" x2="530" y2="248" /><line x1="150" y1="312" x2="530" y2="312" /><line x1="150" y1="376" x2="530" y2="376" />
    </g>
    <g stroke-width=".8" opacity=".6">
      <line x1="300" y1="120" x2="300" y2="440" /><line x1="410" y1="184" x2="410" y2="376" />
      <line x1="150" y1="172" x2="530" y2="172" stroke-dasharray="3 3" /><line x1="150" y1="236" x2="530" y2="236" stroke-dasharray="3 3" /><line x1="150" y1="300" x2="530" y2="300" stroke-dasharray="3 3" /><line x1="150" y1="364" x2="530" y2="364" stroke-dasharray="3 3" />
    </g>
  </g>

  <!-- Facilities: spaces, rooms and people -->
  <g class:list={["dv-l", { on: active === "facilities" }]} data-layer="facilities">
    <rect x="410" y="248" width="120" height="52" class="fill-soft" />
    <g font-size="12" fill="currentColor" class="lbl"><text x="418" y="266">Room 4.07</text><text x="418" y="281" class="sub">Meeting room · 8</text></g>
    <g font-size="11" fill="currentColor" class="lbl sub"><text x="158" y="203">Level 5 · Offices</text><text x="158" y="267">Level 4 · Offices</text><text x="158" y="331">Level 3 · Tenant</text><text x="158" y="395">Level 2 · Tenant</text><text x="158" y="430">Lobby</text></g>
    <g fill="currentColor"><circle cx="452" cy="290" r="4" /><rect x="449" y="294" width="6" height="6" rx="2" /><circle cx="470" cy="290" r="4" /><rect x="467" y="294" width="6" height="6" rx="2" /><circle cx="215" cy="420" r="4" /><rect x="212" y="424" width="6" height="12" rx="2" /></g>
    <g class="callout" font-size="11"><line x1="530" y1="274" x2="582" y2="274" /><text x="588" y="270">Location</text><text x="588" y="284" class="sub">site › floor › room</text></g>
  </g>

  <!-- Assets: equipment with tags and condition -->
  <g class:list={["dv-l", { on: active === "assets" }]} data-layer="assets">
    <rect x="330" y="96" width="120" height="24" rx="2" class="fill-soft" /><text x="338" y="112" font-size="11" fill="currentColor">AHU-03</text>
    <g class="eq"><rect x="436" y="238" width="58" height="10" rx="2" /><rect x="190" y="174" width="58" height="10" rx="2" /><rect x="320" y="302" width="58" height="10" rx="2" /><rect x="190" y="366" width="58" height="10" rx="2" /></g>
    <rect x="436" y="238" width="58" height="10" rx="2" class="hot" />
    <rect x="560" y="408" width="70" height="32" rx="3" class="fill-soft" /><text x="566" y="428" font-size="11" fill="currentColor">Chiller CH-1</text>
    <g class="callout" font-size="11"><line x1="494" y1="243" x2="582" y2="214" /><text x="588" y="208">FCU-L4-07</text><text x="588" y="222" class="sub">condition · warranty · cost</text></g>
    <g class="bars"><rect x="588" y="230" width="60" height="4" rx="2" class="track" /><rect x="588" y="230" width="38" height="4" rx="2" class="val" /></g>
  </g>

  <!-- Maintenance: planned work and parts -->
  <g class:list={["dv-l", { on: active === "maintenance" }]} data-layer="maintenance">
    <g class="cal" font-size="10" fill="currentColor">
      <rect x="40" y="150" width="86" height="96" rx="4" class="fill-paper" />
      <text x="48" y="168" class="b">November</text>
      <g class="sub"><text x="48" y="186">04 · AHU filters</text><text x="48" y="202">11 · Fire doors</text><text x="48" y="218">18 · FCU coils L4</text><text x="48" y="234">25 · Chiller check</text></g>
    </g>
    <g class="ticks" fill="currentColor"><circle cx="462" cy="232" r="5" /><circle cx="216" cy="168" r="5" /><circle cx="346" cy="296" r="5" /></g>
    <rect x="40" y="380" width="86" height="56" rx="4" class="fill-paper" /><g font-size="10" fill="currentColor"><text x="48" y="398" class="b">Stores</text><text x="48" y="414" class="sub">Actuator · 2</text><text x="48" y="428" class="sub">Filters · 40</text></g>
    <path d="M126 210 C 170 210, 180 168, 210 168" class="link" /><path d="M126 410 C 300 410, 380 260, 456 236" class="link" />
  </g>

  <!-- Field service: van, route, technician -->
  <g class:list={["dv-l", { on: active === "field-service" }]} data-layer="field-service">
    <rect x="600" y="410" width="72" height="30" rx="6" class="fill-paper" /><circle cx="616" cy="442" r="6" class="wheel" /><circle cx="656" cy="442" r="6" class="wheel" />
    <path d="M600 432 L 540 432 L 530 432 L 530 300 L 494 260" class="route" />
    <g fill="currentColor"><circle cx="560" cy="414" r="4.5" /><rect x="556.5" y="419" width="7" height="13" rx="2.5" /></g>
    <g class="callout" font-size="11"><line x1="636" y1="408" x2="636" y2="372" /><text x="606" y="352">Rami S.</text><text x="606" y="366" class="sub">ETA 15:12 · part in van</text></g>
  </g>

  <!-- The shared record, always in the middle -->
  <g class="dv-rec">
    <rect x="236" y="20" width="248" height="56" rx="6" />
    <text x="250" y="42" font-size="12" font-weight="600" fill="currentColor">WO-2611-0418 · FCU-L4-07</text>
    <text x="250" y="60" font-size="11" fill="currentColor" class="sub">one record for every domain</text>
    <path d="M360 76 L 360 96" stroke="currentColor" fill="none" stroke-dasharray="2 3" />
  </g>
</svg>

<style>
  .dv { width: 100%; height: auto; color: var(--ink); font-family: var(--font-body); }
  .dv .sub { opacity: .8; }
  .dv .b { font-weight: 600; }
  .dv-base { opacity: 1; }
  .dv-l { opacity: .32; transition: opacity 420ms var(--ease-out), transform 420ms var(--ease-out); transform-box: fill-box; }
  .dv-l.on { opacity: 1; }
  .dv:not([data-active="all"]) .dv-l:not(.on) text { visibility: hidden; }
  .dv[data-active="all"] .dv-l { opacity: .9; }
  .fill-soft { fill: var(--green-tint); stroke: var(--green); stroke-width: 1; }
  .fill-paper { fill: var(--white); stroke: currentColor; stroke-width: .8; }
  .callout line, .link, .route { stroke: currentColor; fill: none; stroke-width: 1; }
  .callout text { fill: currentColor; }
  .link { stroke-dasharray: 3 3; opacity: .7; }
  .route { stroke: var(--green); stroke-width: 1.6; stroke-dasharray: 5 4; }
  .eq rect { fill: #CFD3CF; stroke: currentColor; stroke-width: .6; }
  .hot { fill: #E9A05A; stroke: #8A4D0B; stroke-width: 1; }
  .ticks circle { fill: var(--green); }
  .wheel { fill: var(--ink); }
  .bars .track { fill: #DDE0DB; } .bars .val { fill: var(--green); }
  .dv-rec rect { fill: var(--white); stroke: var(--ink); stroke-width: 1.2; }
</style>
