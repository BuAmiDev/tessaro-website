---
import Icon from './Icon.astro';
import Status from './Status.astro';
const steps = [
  { key: 'issue', label: 'Freezer FZ-07 stops cooling', who: 'Report', icon: 'thermometer-snowflake' },
  { key: 'understood', label: 'Request understood', who: 'Suggestion', icon: 'sparkles' },
  { key: 'coverage', label: 'Coverage checked', who: 'Rule', icon: 'file-check-2' },
  { key: 'matched', label: 'Technician matched', who: 'Dispatcher confirms', icon: 'user-check' },
  { key: 'approval', label: 'Approval required', who: 'Customer decides', icon: 'hand' },
  { key: 'updated', label: 'Customer updated', who: 'Drafted message', icon: 'message-square-text' },
  { key: 'onsite', label: 'Technician on site', who: 'Person', icon: 'wrench' },
  { key: 'recorded', label: 'Completion recorded', who: 'Record', icon: 'clipboard-check' },
];
---
<section class="hero" data-surface="dark" aria-labelledby="hero-title">
  <div class="hero-grid wrap">
    <div class="hero-copy">
      <p class="hero-state"><Status status="designed" /> <span>Tessaro 2.0 · preparing the first pilot release</span></p>
      <h1 id="hero-title" class="hero-title">Keep every operation moving.</h1>
      <p class="hero-sub">Tessaro connects service requests, technicians, equipment, contracts and approvals in one platform. It suggests the next step and shows why. People make the calls that matter, and everyone affected stays informed.</p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-lg" href="/simulator">Explore your scenario <Icon name="arrow-right" size={18} /></a>
        <a class="btn btn-lg" href="/demo">Book a demo</a>
      </div>
      <p class="hero-trial">Prefer to set it up yourself? <a class="link" href="/trial">Start a trial</a></p>
    </div>

    <figure class="hero-stage" data-hero>
      <div class="hero-frame">
        <picture>
          <source media="(max-width: 760px)" srcset="/hero/poster-mobile.webp" width="760" height="762" />
          <img class="hero-poster" src="/hero/poster.webp" width="1400" height="1049" alt="A miniature building made of tiles. A robotic assistant hovers over a cold room where a freezer has failed, with lines connecting it to the office, the plant room and a technician." fetchpriority="high" decoding="async" />
        </picture>
        <canvas class="hero-canvas" aria-hidden="true" data-hero-canvas></canvas>
        <div class="hero-chip" data-hero-chip hidden></div>
        <div class="hero-ctrl">
          <button class="ctrl" type="button" data-hero-toggle aria-label="Play the animation" hidden><Icon name="play" size={16} class="i-play" /><Icon name="pause" size={16} class="i-pause" /><span class="ctrl-t">Play</span></button>
          <button class="ctrl" type="button" data-hero-replay aria-label="Replay the animation" hidden><Icon name="rotate-ccw" size={16} /><span class="ctrl-t">Replay</span></button>
        </div>
      </div>
      <figcaption class="hero-log">
        <p class="hero-log-t">One freezer failure, from report to record <span class="sample">Illustrative sequence</span></p>
        <ol class="hero-steps" data-hero-steps>
          {steps.map((s, i) => (
            <li data-key={s.key} data-i={i}><Icon name={s.icon} size={15} /><span class="hs-l">{s.label}</span><span class="hs-w">{s.who}</span></li>
          ))}
        </ol>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; background: radial-gradient(1200px 700px at 78% 40%, #1F2C28 0%, var(--graphite-900) 62%); padding: clamp(40px, 5vw, 72px) 0 clamp(48px, 5vw, 80px); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(24px, 3vw, 48px); align-items: center; }
  .hero-copy { display: grid; gap: 22px; align-content: center; position: relative; z-index: 2; }
  .hero-state { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; font-size: var(--t-xs); color: var(--fg-2); }
  .hero-title { font-size: var(--t-hero); line-height: .98; letter-spacing: -0.045em; font-weight: 600; max-width: 9.5ch; }
  .hero-sub { font-size: var(--t-lg); line-height: 1.55; color: var(--fg-2); max-width: 46ch; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px; }
  .hero-trial { font-size: var(--t-sm); color: var(--fg-2); }
  .hero-stage { margin: 0; display: grid; gap: 14px; }
  .hero-frame { position: relative; aspect-ratio: 4 / 3; border-radius: var(--r-lg); overflow: hidden; background: #18211E; border: 1px solid var(--line); }
  .hero-poster, .hero-canvas { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-canvas { opacity: 0; transition: opacity 420ms var(--ease-out); }
  .hero-stage.live .hero-canvas { opacity: 1; }
  .hero-chip { position: absolute; left: 0; top: 0; transform: translate(-50%, calc(-100% - 10px)); pointer-events: none; background: rgba(14, 20, 19, .86); border: 1px solid #3A4642; color: #EEF1EE; font-size: var(--t-xs); font-weight: 600; padding: 6px 10px; border-radius: 6px; white-space: nowrap; display: flex; gap: 6px; align-items: center; transition: transform 240ms var(--ease-out); }
  .hero-chip::before { content: ""; width: 7px; height: 7px; border-radius: 2px; background: var(--emerald-400); }
  .hero-chip.attn::before { background: #F2B54A; }
  .hero-ctrl { position: absolute; right: 12px; bottom: 12px; display: flex; gap: 6px; }
  .ctrl { display: inline-flex; align-items: center; gap: 6px; height: 36px; padding: 0 12px; border-radius: 6px; border: 1px solid #3A4642; background: rgba(14, 20, 19, .78); color: #EEF1EE; font-size: var(--t-xs); font-weight: 600; cursor: pointer; backdrop-filter: blur(6px); }
  .ctrl:hover { background: rgba(28, 37, 34, .95); }
  .ctrl :global(.i-pause) { display: none; }
  .ctrl[aria-pressed="true"] :global(.i-pause) { display: block; }
  .ctrl[aria-pressed="true"] :global(.i-play) { display: none; }
  .hero-log { display: grid; gap: 10px; }
  .hero-log-t { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; font-size: var(--t-xs); color: var(--fg-2); font-weight: 600; }
  .hero-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 3px; background: var(--line); border: 3px solid var(--line); border-radius: var(--r-xs); }
  .hero-steps li { background: var(--graphite-800); border-radius: 5px; padding: 9px 10px; display: grid; grid-template-columns: auto 1fr; gap: 2px 8px; align-items: center; font-size: var(--t-xs); color: var(--fg-3); transition: background-color 240ms ease, color 240ms ease; }
  .hero-steps li :global(svg) { grid-row: span 2; color: var(--fg-3); }
  .hs-l { font-weight: 600; color: var(--fg-2); line-height: 1.3; }
  .hs-w { color: var(--fg-3); }
  .hero-steps li.done .hs-l { color: var(--fg); }
  .hero-steps li.done :global(svg) { color: var(--emerald-400); }
  .hero-steps li.now { background: #173A2D; }
  .hero-steps li.now .hs-l { color: #fff; }
  @media (max-width: 980px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-title { max-width: 12ch; }
  }
  @media (max-width: 760px) {
    .hero-frame { aspect-ratio: 1 / 1; }
    .hero-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>

<script>
  // The headline, actions and poster image need no script. The 3D scene loads
  // after the page is idle, only when WebGL works, and never under reduced motion
  // unless the visitor presses Play.
  const stage = document.querySelector<HTMLElement>('[data-hero]')!;
  const canvas = stage.querySelector<HTMLCanvasElement>('[data-hero-canvas]')!;
  const chip = stage.querySelector<HTMLElement>('[data-hero-chip]')!;
  const toggle = stage.querySelector<HTMLButtonElement>('[data-hero-toggle]')!;
  const replay = stage.querySelector<HTMLButtonElement>('[data-hero-replay]')!;
  const items = [...stage.querySelectorAll<HTMLLIElement>('[data-hero-steps] li')];
  const labels: Record<string, string> = Object.fromEntries(items.map((li) => [li.dataset.key!, li.querySelector('.hs-l')!.textContent!]));
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const still = new URLSearchParams(location.search).get('hero-still');

  function paintSteps(idx: number) { items.forEach((li, i) => { li.classList.toggle('done', i <= idx); li.classList.toggle('now', i === idx); }); }
  function webglOK() { try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; } }

  async function boot(autoplay: boolean) {
    if (!webglOK()) return;
    const { createHeroScene, DURATION } = await import('../hero/robot-scene');
    const low = window.matchMedia('(max-width: 760px)').matches || (navigator as any).hardwareConcurrency <= 4;
    const scene = createHeroScene({
      canvas, quality: low ? 'low' : 'high',
      onStep: (i) => paintSteps(i),
      onLabel: (key, x, y) => {
        if (!key) { chip.hidden = true; return; }
        chip.hidden = false; chip.textContent = labels[key]; chip.classList.toggle('attn', key === 'issue' || key === 'approval');
        chip.style.transform = `translate(${x}px, ${y}px) translate(-50%, calc(-100% - 10px))`;
      },
      onEnd: () => { setPlaying(false); replay.hidden = false; },
    });
    const setPlaying = (p: boolean) => { toggle.setAttribute('aria-pressed', String(p)); toggle.setAttribute('aria-label', p ? 'Pause the animation' : 'Play the animation'); toggle.querySelector('.ctrl-t')!.textContent = p ? 'Pause' : 'Play'; };
    if (still) { scene.renderStill(parseFloat(still)); stage.classList.add('live'); document.documentElement.dataset.heroReady = '1'; return; }
    stage.classList.add('live');
    toggle.hidden = false; replay.hidden = true;
    toggle.addEventListener('click', () => { if (scene.playing) { scene.pause(); setPlaying(false); } else { scene.play(); setPlaying(true); replay.hidden = false; } });
    replay.addEventListener('click', () => { scene.replay(); setPlaying(true); });
    new ResizeObserver(() => scene.resize()).observe(canvas);
    let userPaused = false;
    toggle.addEventListener('click', () => { userPaused = !scene.playing; });
    const io = new IntersectionObserver(([e]) => { if (!e.isIntersecting && scene.playing) { scene.pause(); setPlaying(false); } else if (e.isIntersecting && !userPaused && scene.time < DURATION && autoplay && scene.time > 0) { scene.play(); setPlaying(true); } }, { threshold: 0.2 });
    io.observe(stage);
    document.addEventListener('visibilitychange', () => { if (document.hidden && scene.playing) { scene.pause(); setPlaying(false); } });
    if (autoplay) { scene.play(); setPlaying(true); } else { scene.seek(DURATION); paintSteps(items.length - 1); }
  }

  // Phones, low-power devices and data-saver visitors keep the poster frame and can
  // start the 3D scene themselves; it costs CPU that matters more for the page.
  const light = window.matchMedia('(max-width: 760px)').matches || ((navigator as any).hardwareConcurrency || 8) <= 4 || (navigator as any).connection?.saveData === true;
  if (still) boot(false);
  else if (reduce || light) {
    // Static alternative: full step list visible, scene available on request.
    paintSteps(items.length - 1); toggle.hidden = false; toggle.querySelector('.ctrl-t')!.textContent = 'Play animation';
    toggle.addEventListener('click', () => boot(true).then(() => {}), { once: true });
  } else {
    const start = () => boot(true);
    if ('requestIdleCallback' in window) (window as any).requestIdleCallback(start, { timeout: 1500 }); else setTimeout(start, 600);
  }
</script>
