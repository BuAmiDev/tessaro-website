---
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { brand } from '../config/brand';
interface Props {
  title: string;            // page name only; brand is appended
  description: string;
  headerTone?: 'light' | 'dark';
  current?: string;
  noindex?: boolean;
  bodySurface?: 'light' | 'dark';
}
const { title, description, headerTone = 'light', current, noindex = false, bodySurface = 'light' } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/', brand.siteUrl).href;
const fullTitle = title === brand.name ? `${brand.name} · Field service and facilities operations` : `${title} · ${brand.name}`;
const og = new URL('/og.png', brand.siteUrl).href;
---
<!doctype html>
<html lang="en" dir="ltr" data-surface={bodySurface === 'dark' ? 'dark' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={"#F7F7F4"} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/sora-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-sans-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header tone={headerTone} current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
<style is:global>
  main:focus { outline: none; }
</style>
