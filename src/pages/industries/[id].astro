---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import CapCard from '../../components/CapCard.astro';
import { INDUSTRIES } from '../../content/industries';
import { capabilityById } from '../../content/capabilities';
import { scenarioById } from '../../lib/scenario-engine';
export function getStaticPaths() { return INDUSTRIES.map((ind) => ({ params: { id: ind.id }, props: { ind } })); }
const { ind } = Astro.props;
const caps = ind.capabilities.map((id) => capabilityById[id]).filter(Boolean);
---
<Base title={ind.name} description={ind.who} current="industries">
  <PageIntro title={ind.name} lead={ind.who} crumbs={[['Solutions', '/industries']]} eyebrow={ind.operatingModel}>
    <div class="aside">
      {ind.status === 'proposed' && <p class="small prop">This operation reuses designed building blocks but hasn’t been validated with operators yet. Expect gaps, and tell us about them.</p>}
      <p class="small muted">Typical starting point: {ind.defaults.sites} sites, {ind.defaults.team} people.</p>
      <a class="btn btn-primary" href={`/configurator?industry=${ind.id}`}>Start from this template</a>
    </div>
  </PageIntro>
  <section class="section flush-top">
    <div class="wrap two">
      <div>
        <h2 class="h3">What usually goes wrong</h2>
        <ol role="list" class="pains">{ind.pains.map((p, i) => <li><span>{String(i + 1).padStart(2, '0')}</span>{p}</li>)}</ol>
      </div>
      <div>
        <h2 class="h3">Run it with your numbers</h2>
        <ul role="list" class="scs">{ind.scenarios.map((s) => <li><a href={`/simulator?industry=${ind.id}&scenario=${s}`}><b>{scenarioById[s].name}</b><span>{scenarioById[s].oneLine}</span></a></li>)}</ul>
        <p class="small muted">Scenarios use sample data and compressed timelines.</p>
      </div>
    </div>
  </section>
  <section class="section tight">
    <div class="wrap"><h2 class="h3 ch">The parts that matter most</h2><ul role="list" class="caps">{caps.map((c) => <CapCard c={c} />)}</ul></div>
  </section>
  <section class="section tight end">
    <div class="wrap row between">
      <p class="h3">See it with your contracts and sites.</p>
      <div class="row"><a class="btn btn-primary" href={`/demo?industry=${ind.id}`}>Book a demo</a><a class="btn" href={`/trial`}>Start a trial</a></div>
    </div>
  </section>
</Base>
<style>
  .aside { display: grid; gap: 14px; justify-items: start; }
  .prop { color: var(--wait); }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; }
  .two > div { display: grid; gap: 20px; align-content: start; }
  .pains { margin: 0; border-top: 1px solid var(--line); }
  .pains li { display: grid; grid-template-columns: 40px 1fr; padding: 16px 0; border-bottom: 1px solid var(--line); font-size: 1.125rem; }
  .pains span { color: var(--fg-3); font-size: var(--t-sm); padding-top: 4px; }
  .scs { margin: 0; border-top: 1px solid var(--line); }
  .scs a { display: grid; gap: 4px; padding: 16px 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .scs a:hover b { color: var(--green); text-decoration: underline; }
  .scs span { color: var(--fg-2); font-size: var(--t-sm); }
  .ch { margin-bottom: 16px; }
  .caps { margin: 0; border-bottom: 1px solid var(--line); }
  .end { background: var(--white); }
  .between { justify-content: space-between; }
  @media (max-width: 900px) { .two { grid-template-columns: 1fr; gap: 48px; } }
</style>
<script>import { wireAddButtons } from '../../scripts/add-buttons'; wireAddButtons();</script>
