---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import { INDUSTRIES } from '../../content/industries';
import { scenarioById } from '../../lib/scenario-engine';
---
<Base title="Solutions" description="How Tessaro works for HVAC and refrigeration service, property management, facilities maintenance, retail facilities and cold-chain operations." current="industries">
  <PageIntro title="Built around how your work actually runs." lead="Start from the operation closest to yours. Each one shows the jobs that usually go wrong, the parts of Tessaro that matter most and a scenario you can run with your own numbers." eyebrow="Solutions" />
  <section class="section flush-top">
    <div class="wrap">
      <ol role="list" class="ind">
        {INDUSTRIES.map((ind, i) => (
          <li>
            <span class="ix">{String(i + 1).padStart(2, '0')}</span>
            <div class="it"><h2><a href={`/industries/${ind.id}`}>{ind.name}</a></h2>{ind.status === 'proposed' && <p class="prop">Proposed: reuses designed building blocks, not yet validated with operators.</p>}</div>
            <p class="iw">{ind.who}</p>
            <a class="link small" href={`/simulator?industry=${ind.id}&scenario=${ind.scenarios[0]}`}>Run “{scenarioById[ind.scenarios[0]].name}”</a>
          </li>
        ))}
      </ol>
      <div class="other">
        <h2 class="h3">Something else?</h2>
        <p class="muted">Lifts, fire safety, security systems or another trade. Tell us how your work runs and we’ll show what fits, and what doesn’t yet.</p>
        <a class="btn" href="/demo?topic=other-industry">Describe your operation</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .ind { margin: 0; border-bottom: 1px solid var(--line); }
  .ind li { display: grid; grid-template-columns: 48px minmax(0, 5fr) minmax(0, 5fr) minmax(160px, 2fr); gap: 12px 32px; padding: 32px 0; border-top: 1px solid var(--line); align-items: baseline; }
  .ix { font-size: var(--t-sm); color: var(--fg-3); font-variant-numeric: tabular-nums; }
  .it { display: grid; gap: 6px; }
  .it h2 { font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.1rem); letter-spacing: -0.03em; }
  .it a { text-decoration: none; } .it a:hover { color: var(--green); }
  .prop { font-size: var(--t-sm); color: var(--fg-3); font-style: italic; }
  .iw { color: var(--fg-2); }
  .other { margin-top: 96px; display: grid; gap: 14px; justify-items: start; max-width: 620px; }
  @media (max-width: 900px) { .ind li { grid-template-columns: 1fr; gap: 10px; } .ix { display: none; } }
</style>
