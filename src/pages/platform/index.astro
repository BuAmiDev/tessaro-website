---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import Status from '../../components/Status.astro';
import Icon from '../../components/Icon.astro';
import { PLATFORM } from '../../content/platform';
import { CAPABILITIES } from '../../content/capabilities';
const surfaces = [
  { t: 'Office web app', d: 'Dispatch, contracts, assets, approvals, reports and configuration.', n: '112 designed screens' },
  { t: 'Technician app', d: 'Jobs, safety checks, checklists, evidence and sign-off, offline-ready.', n: '30 designed screens' },
  { t: 'Resident app', d: 'Report, track, let technicians in and sign off, in English or Arabic.', n: '42 designed screens' },
  { t: 'Customer and owner portals', d: 'Requests, approvals, contracts, evidence and reports.', n: '23 designed screens' },
  { t: 'WhatsApp flows', d: 'Consent, guided intake, milestones and approvals in chat.', n: '9 designed flows' },
  { t: 'Control Center', d: 'For BWC: onboarding, provisioning, licensing and support grants.', n: '40 designed screens' },
];
---
<Base title="Platform" description="One Tessaro platform for service intake, dispatch, technicians, assets, contracts, approvals and reporting, with apps and portals for residents, customers and owners." current="platform">
  <PageIntro title="One platform for the whole service operation" lead="Tessaro unifies the work of facilities management, maintenance management and field service in one data model, used through different apps for each person involved.">
    <div class="row"><Status status="designed" /><span class="small muted">256 screens designed and clickable in the prototype; first pilot release in preparation.</span></div>
  </PageIntro>
  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>What it covers</h2><p>Ten areas, each with its capabilities, designed screens and a scenario to try.</p></div>
      <ul class="areas tilegrid" role="list">
        {PLATFORM.map((p) => { const caps = CAPABILITIES.filter((c) => p.groups.includes(c.group)); return (
          <li><a href={`/platform/${p.slug}`}><h3>{p.title}</h3><p>{p.lead}</p><span class="xs muted">{caps.length} capabilities</span></a></li>
        ); })}
      </ul>
    </div>
  </section>
  <section class="section" data-surface="dark">
    <div class="wrap">
      <div class="section-head"><h2>Where people work</h2><p>Six surfaces on one record. Counts are designed screens in the prototype.</p></div>
      <ul class="surf" role="list">{surfaces.map((s) => <li><h3>{s.t}</h3><p class="muted small">{s.d}</p><span class="chip">{s.n}</span></li>)}</ul>
      <div class="row" style="margin-top:28px"><a class="btn btn-primary" href="https://tessaro-prototype.vercel.app" target="_blank" rel="noopener">Open the clickable prototype <Icon name="arrow-up-right" size={16} /></a><a class="btn" href="/features">Browse every capability</a></div>
    </div>
  </section>
</Base>
<style>
  .areas { grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0; }
  .areas a { display: grid; gap: 8px; padding: 24px; text-decoration: none; height: 100%; }
  .areas a:hover h3 { text-decoration: underline; text-decoration-color: var(--accent); }
  .areas h3 { font-size: 1.25rem; } .areas p { color: var(--fg-2); font-size: var(--t-sm); }
  .surf { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 0; }
  .surf li { padding: 24px; border: 1px solid var(--line); border-radius: var(--r-md); background: var(--surface); display: grid; gap: 10px; align-content: start; justify-items: start; }
  .surf h3 { font-size: 1.15rem; }
  @media (max-width: 860px) { .areas, .surf { grid-template-columns: 1fr; } }
</style>
