---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import ProductShot from '../../components/ProductShot.astro';
import CapCard from '../../components/CapCard.astro';
import Icon from '../../components/Icon.astro';
import { PLATFORM } from '../../content/platform';
import { CAPABILITIES } from '../../content/capabilities';
import { scenarioById } from '../../lib/scenario-engine';
export function getStaticPaths() { return PLATFORM.map((p) => ({ params: { slug: p.slug }, props: { p } })); }
const { p } = Astro.props;
const caps = CAPABILITIES.filter((c) => p.groups.includes(c.group));
const i = PLATFORM.findIndex((x) => x.slug === p.slug);
const next = PLATFORM[(i + 1) % PLATFORM.length];
const sc = scenarioById[p.scenario];
---
<Base title={p.title} description={p.lead} current="platform">
  <PageIntro title={p.title} lead={p.lead} crumbs={[['Platform', '/platform']]}>
    <div class="row"><a class="btn btn-primary" href={`/simulator?scenario=${p.scenario}`}>Try it: {sc.name} <Icon name="arrow-right" size={16} /></a></div>
  </PageIntro>
  <section class="section">
    <div class="wrap pd">
      <ProductShot id={p.shot.id} w={p.shot.w} h={p.shot.h} alt={p.shot.alt} lazy={false} />
      <div class="pd-side">
        <h2 class="h3">How the parts connect</h2>
        <p class="muted">{caps.length} capabilities in this area share one record with the rest of the platform. A request created here keeps its contract, asset, approvals and evidence wherever it goes next.</p>
        <p class="xs muted">The screen is from the clickable prototype with sample data. It is not a live customer workspace.</p>
      </div>
    </div>
  </section>
  <section class="section tight">
    <div class="wrap">
      <div class="section-head"><h2>Capabilities</h2></div>
      <ul class="cgrid" role="list">{caps.map((c) => <CapCard c={c} />)}</ul>
    </div>
  </section>
  <section class="section tight">
    <div class="wrap nextrow">
      <a class="btn" href="/platform"><Icon name="arrow-left" size={16} /> All areas</a>
      <a class="btn btn-quiet" href={`/platform/${next.slug}`}>Next: {next.title} <Icon name="arrow-right" size={16} /></a>
    </div>
  </section>
</Base>
<style>
  .pd { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 40px; align-items: center; }
  .pd-side { display: grid; gap: 14px; }
  .cgrid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 0; }
  .nextrow .btn { white-space: normal; }
  .nextrow { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  @media (max-width: 1000px) { .cgrid { grid-template-columns: 1fr 1fr; } .pd { grid-template-columns: 1fr; } }
  @media (max-width: 640px) { .cgrid { grid-template-columns: 1fr; } }
</style>
<script>import { wireAddButtons } from '../../scripts/add-buttons'; wireAddButtons();</script>
