---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import CapCard from '../../components/CapCard.astro';
import DomainVisual from '../../components/DomainVisual.astro';
import { PLATFORM } from '../../content/platform';
import { DOMAINS } from '../../content/domains';
import { CAPABILITIES, capabilityById } from '../../content/capabilities';
import { scenarioById } from '../../lib/scenario-engine';
import { brand } from '../../config/brand';
import AppShowcase from '../../components/AppShowcase.astro';
import { ROLES, TECHNICIAN_DEEP } from '../../content/apps';
export function getStaticPaths() {
  return [
    ...DOMAINS.map((d) => ({ params: { slug: d.id }, props: { kind: 'domain' as const, id: d.id } })),
    ...PLATFORM.map((p) => ({ params: { slug: p.slug }, props: { kind: 'area' as const, id: p.slug } })),
  ];
}
const { kind, id } = Astro.props;
const d = kind === 'domain' ? DOMAINS.find((x) => x.id === id)! : null;
const a = kind === 'area' ? PLATFORM.find((x) => x.slug === id)! : null;
const title = d ? d.name : a!.title;
const lead = d ? d.body : a!.lead;
const caps = d ? d.covers.map((c) => capabilityById[c]).filter(Boolean) : CAPABILITIES.filter((c) => a!.groups.includes(c.group));
const scenario = d ? (caps.find((c) => c.scenarios.length)?.scenarios[0] ?? 'bms-alarm') : a!.scenario;
const apps = ['field-service', 'field'].includes(id)
  ? { anchor: 'technician-app', title: 'The technician app', lead: 'What the person on site sees, from reviewing the job to closing it with proof. Step through the designed screens.', roles: [TECHNICIAN_DEEP], layout: 'single' as const }
  : ['facilities', 'stakeholders'].includes(id)
  ? { anchor: 'customer-apps', title: 'The requester app and the customer portal', lead: 'Occupants report and follow their requests on their phone. Business customers review open work and make decisions in the portal, in the browser.', roles: [ROLES.requester, ROLES.portal], layout: 'pair' as const }
  : null;
const others = d ? DOMAINS.filter((x) => x.id !== d.id) : [];
const links: Record<string, string> = {
  facilities: 'Requests from a room attach to the asset that serves it, so maintenance and field teams start with the right unit.',
  maintenance: 'Planned visits are generated from the asset register and dispatched like any other job.',
  'field-service': 'Every visit writes back readings, photos and parts to the asset’s history.',
  assets: 'Condition and cost come from the work actually done, not from a separate spreadsheet.',
};
---
<Base title={d ? `${d.name} (${d.acronym})` : title} description={lead} current="platform">
  <PageIntro title={title} lead={lead} crumbs={[['Platform', '/platform']]} eyebrow={d ? `${d.acronym} · ${d.short}` : 'Shared capability'}>
    <div class="ia">
      <a class="btn btn-primary" href={`/simulator?scenario=${scenario}`}>Try it in a scenario</a>
      <p class="small muted">Scenario: {scenarioById[scenario]?.name}</p>
    </div>
  </PageIntro>

  {d && (
    <section class="section flush-top">
      <div class="wrap dd">
        <div class="dd-vis"><DomainVisual active={d.id} /></div>
        <div class="dd-copy">
          <p class="dd-q">{d.question}</p>
          <p class="muted">{links[d.id]}</p>
          <h2 class="h4">Connected to</h2>
          <ul role="list" class="dd-o">{others.map((o) => <li><a href={`/platform/${o.id}`}>{o.name}</a><span>{links[o.id]}</span></li>)}</ul>
        </div>
      </div>
    </section>
  )}

  {apps && (
    <section class="section apps-s" id={apps.anchor} aria-labelledby="apps-s-t">
      <div class="wrap">
        <div class="apps-h"><h2 id="apps-s-t" class="h3">{apps.title}</h2><p class="muted">{apps.lead}</p></div>
        <AppShowcase uid={`${id}-apps`} layout={apps.layout} roles={apps.roles} note="Designed screens from the Tessaro 2.0 prototype, shown with sample data. Not yet in production." />
      </div>
    </section>
  )}

  <section class="section tight">
    <div class="wrap">
      <div class="caps-h"><h2 class="h3">What it covers</h2><p class="small muted">Availability is shown on each item. “Designed” means specified and clickable in the <a class="link" href={brand.productUrl} target="_blank" rel="noopener">prototype</a>, not yet in production.</p></div>
      <ul role="list" class="caps">{caps.map((c) => <CapCard c={c} />)}</ul>
    </div>
  </section>

  <section class="section tight next">
    <div class="wrap row between">
      <a class="link" href="/platform">How the platform fits together</a>
      <a class="link" href="/features">Search every capability</a>
    </div>
  </section>
</Base>
<style>
  .ia { display: grid; gap: 10px; justify-items: start; }
  .dd { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 64px; align-items: center; }
  .dd-vis { background: var(--white); border-radius: var(--r-lg); padding: clamp(16px, 2.4vw, 36px); }
  .dd-copy { display: grid; gap: 16px; }
  .dd-q { font-family: var(--font-display); font-size: var(--t-xl); letter-spacing: -0.025em; line-height: 1.15; }
  .dd-o { margin: 0; border-top: 1px solid var(--line); }
  .dd-o li { display: grid; gap: 4px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .dd-o a { font-weight: 600; text-decoration: none; } .dd-o a:hover { color: var(--green); text-decoration: underline; }
  .dd-o span { font-size: var(--t-sm); color: var(--fg-2); }
  .caps-h { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 16px 40px; align-items: end; margin-bottom: 24px; }
  .caps { margin: 0; border-bottom: 1px solid var(--line); }
  .between { justify-content: space-between; }
  .apps-s { background: var(--white); scroll-margin-top: var(--hdr-h); }
  .apps-h { display: grid; gap: 10px; max-width: 68ch; margin-bottom: 36px; }
  @media (max-width: 1000px) { .dd, .caps-h { grid-template-columns: 1fr; } }
</style>
<script>import { wireAddButtons } from '../../scripts/add-buttons'; wireAddButtons();</script>
