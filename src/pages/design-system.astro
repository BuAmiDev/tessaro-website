---
import Base from '../layouts/Base.astro';
import Status from '../components/Status.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
const palette = [['Chalk', '--chalk', '#F7F7F4'], ['White', '--white', '#FFFFFF'], ['Ink', '--ink', '#202522'], ['Ink 2', '--ink-2', '#4A524D'], ['Ink 3', '--ink-3', '#646C67'], ['Line', '--line-c', '#D9DDD7'], ['Green', '--green', '#245B46'], ['Green tint', '--green-tint', '#E8EFEB'], ['Night', '--night', '#121614'], ['Brass', '--brass', '#B8863B']];
const semantic = [['OK', '--ok'], ['Waiting', '--wait'], ['Needs action', '--alert'], ['Information', '--info']];
const type = [['Hero', '--t-hero', 'display'], ['3XL', '--t-3xl', 'display'], ['2XL', '--t-2xl', 'display'], ['XL', '--t-xl', 'display'], ['Lead', '--t-lg', 'body'], ['Body', '--t-md', 'body'], ['Control', '--t-ui', 'body'], ['Small', '--t-sm', 'body']];
---
<Base title="Design system" description="Tessaro website tokens and component specimen." noindex>
  <section class="section tight"><div class="wrap ds">
    <header class="ds-h"><Logo height={44} /><h1>Design system</h1><p class="lead">Chalk and ink, one controlled green, architectural space. Containers only where something is interactive, compared or saved.</p></header>

    <section aria-labelledby="ds-type"><h2 id="ds-type" class="h3">Type</h2>
      <div class="pair">
        <div><p class="small muted">Display · Sora variable (retained)</p><p class="spec-d">One intelligence across your spaces.</p></div>
        <div><p class="small muted">Text and interface · Instrument Sans variable (replaces IBM Plex Sans)</p><p class="spec-b">Coverage is checked against the maintenance contract. The quote is above the AED 2,000 limit, so it waits for the owner while the technician makes the unit safe.</p></div>
        <div lang="ar" dir="rtl"><p class="small muted" dir="ltr">Arabic script · IBM Plex Sans Arabic (Instrument Sans has no Arabic)</p><p class="spec-b">تم استلام طلبك وسيصل الفني خلال أربع ساعات.</p></div>
      </div>
      <table class="scale"><caption class="sr-only">Type scale</caption><tbody>
        {type.map(([n, v, f]) => <tr><td class="small"><code>{v}</code></td><td style={`font-size:var(${v});font-family:var(--font-${f});font-weight:${f === 'display' ? 540 : 420};letter-spacing:${f === 'display' ? '-0.035em' : '0'};line-height:1.1`}>{n} · Keep every operation moving</td></tr>)}
      </tbody></table>
    </section>

    <section aria-labelledby="ds-color"><h2 id="ds-color" class="h3">Colour</h2>
      <ul class="sw" role="list">{palette.map(([n, v, h]) => <li><span class="chip-c" style={`background:var(${v})`}></span><b class="small">{n}</b><code class="small">{h}</code></li>)}</ul>
      <ul class="sw" role="list">{semantic.map(([n, v]) => <li><span class="chip-c" style={`background:var(${v})`}></span><b class="small">{n}</b><code class="small">{v}</code></li>)}</ul>
    </section>

    <section aria-labelledby="ds-comp"><h2 id="ds-comp" class="h3">Component specimen</h2>
      <div class="spec">
        <div class="sp"><p class="sp-k">Buttons</p>
          <div class="row"><button class="btn btn-primary" type="button">Book a demo</button><button class="btn" type="button">Start a trial</button><button class="btn btn-quiet" type="button">Skip story</button><button class="btn btn-sm" type="button">Save to my setup</button><button class="btn" type="button" disabled>Disabled</button><button class="btn" type="button" aria-disabled="true"><span class="spin"></span> Sending</button></div>
          <div class="row dark" data-surface="dark"><button class="btn btn-primary" type="button">Primary on dark</button><button class="btn" type="button">Secondary on dark</button></div>
        </div>
        <div class="sp"><p class="sp-k">Panel (interaction, saved object or comparison only)</p>
          <div class="panel panel-pad demo-panel"><p class="h4">WO-2611-0418 · FCU-L4-07</p><p class="small muted">Assigned to Rami S. · update sent 14:06</p><div class="row"><button class="btn btn-sm" type="button">Open</button><button class="btn btn-sm btn-quiet" type="button">Remove</button></div></div>
        </div>
        <div class="sp"><p class="sp-k">Open content row</p>
          <div><div class="orow"><h3 class="h4">Control</h3><p class="muted">Roles and permissions per site and customer, an audit log of every change, and support access only through grants you approve.</p></div></div>
        </div>
        <div class="sp"><p class="sp-k">Form field, hint, error</p>
          <div class="forms">
            <div class="field"><label for="ds1">Work email</label><input class="input" id="ds1" placeholder="name@company.com" /><p class="hint">We’ll send a 6-digit code.</p></div>
            <div class="field"><label for="ds2">Work email</label><input class="input" id="ds2" aria-invalid="true" value="name@" aria-describedby="ds2e" /><p class="error" id="ds2e"><Icon name="circle-alert" size={16} /> Enter an email like name@company.com.</p></div>
            <div class="field"><label for="ds3">Plan</label><select class="select" id="ds3"><option>Business</option></select></div>
            <label class="choice"><input type="checkbox" checked /> <span><b>Chargeable work needs approval</b><br /><span class="small muted">Work below the limit keeps moving.</span></span></label>
          </div>
        </div>
        <div class="sp"><p class="sp-k">Tabs</p>
          <div class="tabs" role="tablist" aria-label="Specimen tabs"><button role="tab" aria-selected="true" type="button">Facilities</button><button role="tab" aria-selected="false" type="button" tabindex="-1">Maintenance</button><button role="tab" aria-selected="false" type="button" tabindex="-1">Field service</button><button role="tab" aria-selected="false" type="button" tabindex="-1">Assets</button></div>
        </div>
        <div class="sp"><p class="sp-k">Availability (detail views and the availability table only)</p>
          <div class="row"><Status status="designed" /><Status status="pilot" /><Status status="proposed" /><Status status="live" /></div>
          <p class="notice-test small">Test mode: shown wherever a test adapter stands in for a real service.</p>
        </div>
        <div class="sp"><p class="sp-k">Footer group</p>
          <div class="fg"><h4 class="fg-t">Platform</h4><ul role="list"><li><a href="#">Facilities</a></li><li><a href="#">Maintenance</a></li><li><a href="#">Field service</a></li><li><a href="#">Asset management</a></li></ul></div>
        </div>
      </div>
    </section>

    <section aria-labelledby="ds-motion"><h2 id="ds-motion" class="h3">Motion and radii</h2>
      <p class="muted">Ease-out to enter, ease-in-out to move. Presses 120 ms, panels 300 ms. One opening assembly, then architecture stays still. Reduced motion: composed stills and direct transitions. Radii 4 · 6 · 10 · 16; nested radius equals outer minus padding.</p>
    </section>
  </div></section>
</Base>
<style>
  .ds { display: grid; gap: 72px; }
  .ds > section { display: grid; gap: 24px; }
  .ds-h { display: grid; gap: 20px; max-width: 760px; }
  .pair { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; }
  .pair > div { display: grid; gap: 10px; align-content: start; }
  .spec-d { font-family: var(--font-display); font-size: var(--t-2xl); font-weight: 540; letter-spacing: -0.04em; line-height: 1.02; }
  .spec-b { font-size: var(--t-md); }
  [lang="ar"] .spec-b { font-family: var(--font-arabic); }
  .scale { width: 100%; border-collapse: collapse; }
  .scale td { border-top: 1px solid var(--line); padding: 12px 16px 12px 0; vertical-align: middle; }
  .scale td:last-child { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 0; width: 80%; }
  .sw { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 16px; margin: 0; }
  .sw li { display: grid; gap: 4px; }
  .chip-c { height: 56px; border-radius: var(--r-sm); box-shadow: inset 0 0 0 1px rgba(32,37,34,.12); }
  .spec { display: grid; grid-template-columns: 1fr 1fr; gap: 0 48px; }
  .sp { display: grid; gap: 14px; align-content: start; padding: 24px 0; border-top: 1px solid var(--line); }
  .sp-k { font-size: var(--t-sm); color: var(--fg-3); font-weight: 600; }
  .dark { padding: 20px; border-radius: var(--r-md); background: var(--night); }
  .demo-panel { display: grid; gap: 8px; max-width: 420px; }
  .forms { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .fg-t { font-size: var(--t-sm); color: var(--ink-3); margin-bottom: 10px; }
  .fg ul { margin: 0; display: grid; gap: 4px; } .fg a { text-decoration: none; } .fg a:hover { color: var(--green); text-decoration: underline; }
  @media (max-width: 900px) { .pair, .spec, .forms { grid-template-columns: 1fr; } }
</style>
