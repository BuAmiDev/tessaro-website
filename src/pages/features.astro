---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Status from '../components/Status.astro';
import { CAPABILITIES, GROUPS, ROLE_NAMES, capabilityById } from '../content/capabilities';
import { DOMAINS } from '../content/domains';
import { STATUS, brand } from '../config/brand';
import { scenarioById } from '../lib/scenario-engine';
const counts = Object.fromEntries(Object.keys(STATUS).map((k) => [k, CAPABILITIES.filter((c) => c.status === k).length]));
const domainOf = (id: string) => DOMAINS.filter((d) => d.covers.includes(id)).map((d) => d.id).join(' ');
---
<Base title="Feature explorer" description="Search every Tessaro capability by outcome, role or domain. Each one shows who uses it, an example, the designed screens behind it and what exists today." current="resources">
  <PageIntro kind="tool" title="Feature explorer" lead="Every capability, grouped by the question it answers. Search, filter by who uses it, and save what matters to your setup." />

  <section class="section tight flush-top" data-explorer>
    <div class="wrap fx">
      <form class="fx-filters" role="search" aria-label="Filter capabilities" onsubmit="return false">
        <div class="field"><label for="q">Search</label><input class="input" type="search" id="q" name="q" placeholder="approval, offline, warranty…" autocomplete="off" spellcheck="false" /></div>
        <div class="field"><label for="domain">Domain</label>
          <select class="select" id="domain" name="domain"><option value="">All four</option>{DOMAINS.map((d) => <option value={d.id}>{d.name} ({d.acronym})</option>)}</select></div>
        <div class="field"><label for="role">Who uses it</label>
          <select class="select" id="role" name="role"><option value="">Everyone</option>{Object.entries(ROLE_NAMES).map(([k, v]) => <option value={k}>{v}</option>)}</select></div>
        <div class="field"><label for="status">Availability</label>
          <select class="select" id="status" name="status"><option value="">Any</option>{Object.entries(STATUS).map(([k, v]) => <option value={k}>{v.label}</option>)}</select></div>
        <fieldset class="fx-groups"><legend class="label">Question</legend>
          <label class="gq"><input type="radio" name="group" value="" checked /> <span>All</span></label>
          {Object.entries(GROUPS).map(([k, g]) => <label class="gq"><input type="radio" name="group" value={k} /> <span>{g.question}</span></label>)}
        </fieldset>
      </form>

      <div class="fx-results">
        <p class="fx-count" aria-live="polite" data-count></p>
        <ul class="fx-list" role="list">
          {CAPABILITIES.map((c) => (
            <li class="fc" id={c.id} data-group={c.group} data-domain={domainOf(c.id)} data-status={c.status} data-roles={c.roles.join(' ')} data-text={`${c.name} ${c.outcome} ${c.example} ${GROUPS[c.group].name}`.toLowerCase()}>
              <div class="fc-h"><p class="fc-g">{GROUPS[c.group].name}</p><h2 class="fc-t">{c.name}</h2><Status status={c.status} /></div>
              <div class="fc-b">
                <p>{c.outcome}</p>
                <p class="fc-ex">{c.example}</p>
                <p class="fc-m">
                  {c.roles.map((r) => ROLE_NAMES[r]).join(' · ')}
                  {c.ai && <> · Suggests or drafts; a person confirms</>}
                  {c.evidence.length > 0 && <> · Screens {c.evidence.map((e, i) => <>{i > 0 && ', '}<a href={`${brand.productUrl}/#${e}`} target="_blank" rel="noopener">{e}</a></>)}</>}
                  {c.dependsOn && <> · Needs {c.dependsOn.map((d, i) => <>{i > 0 && ', '}<a href={`#${d}`}>{capabilityById[d].name}</a></>)}</>}
                </p>
                <div class="fc-a">
                  {c.status !== 'proposed' ? <button class="btn btn-sm" type="button" data-add={c.id} aria-pressed="false"><span>Save to my setup</span></button> : <span class="small muted">Proposed items can’t be saved yet</span>}
                  {c.scenarios[0] && <a class="link small" href={`/simulator?scenario=${c.scenarios[0]}`}>See it in “{scenarioById[c.scenarios[0]].name}”</a>}
                </div>
              </div>
            </li>
          ))}
        </ul>
        <div class="fx-empty" hidden data-empty>
          <h2 class="h3">Nothing matches that yet</h2>
          <p class="muted">Try a broader word or clear the filters. If you need something we haven’t designed, tell us; it shapes what we build next.</p>
          <div class="row"><button class="btn" type="button" data-clear>Clear filters</button><a class="link" href="/demo?topic=other">Describe what you need</a></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section tight avail" id="availability" aria-labelledby="av-t">
    <div class="wrap av">
      <div><h2 id="av-t" class="h3">What exists today</h2><p class="muted">Tessaro 2.0 is designed end to end and preparing its first pilot release. Nothing is in production yet; we’ll move items to Available only once they run and are verified.</p></div>
      <table class="av-t">
        <thead><tr><th scope="col">Availability</th><th scope="col">Meaning</th><th scope="col" class="n">Capabilities</th></tr></thead>
        <tbody>{Object.entries(STATUS).map(([k, v]) => <tr><th scope="row"><Status status={k as any} /></th><td>{v.note}</td><td class="n num">{counts[k]}</td></tr>)}</tbody>
      </table>
    </div>
  </section>
</Base>

<style>
  .fx { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: 56px; align-items: start; }
  .fx-filters { display: grid; gap: 18px; position: sticky; top: calc(var(--hdr-h) + 20px); max-height: calc(100dvh - var(--hdr-h) - 40px); overflow: auto; padding-right: 4px; }
  .fx-groups { border: 0; padding: 0; margin: 0; display: grid; gap: 0; min-width: 0; }
  .fx-filters { min-width: 0; }
  .fx-groups legend { margin-bottom: 6px; }
  .gq { display: flex; gap: 10px; align-items: flex-start; padding: 8px 0; font-size: var(--t-sm); cursor: pointer; color: var(--fg-2); border-bottom: 1px solid var(--line); }
  .gq:has(input:checked) { color: var(--fg); font-weight: 600; }
  .gq input { margin-top: 4px; }
  .fx-results { min-width: 0; }
  .fx-count { font-size: var(--t-sm); color: var(--fg-2); margin-bottom: 8px; }
  .fx-list { margin: 0; border-bottom: 1px solid var(--line); }
  .fc { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: 12px 40px; padding: 28px 0; border-top: 1px solid var(--line); scroll-margin-top: calc(var(--hdr-h) + 16px); }
  .fc:target { background: linear-gradient(90deg, var(--green-tint), transparent 70%); }
  .fc-h { display: grid; gap: 8px; align-content: start; justify-items: start; }
  .fc-g { font-size: var(--t-sm); color: var(--fg-3); }
  .fc-t { font-size: 1.375rem; line-height: 1.2; }
  .fc-b { display: grid; gap: 10px; }
  .fc-ex { color: var(--fg-2); font-size: var(--t-sm); padding-left: 14px; border-left: 2px solid var(--line); }
  .fc-m { font-size: var(--t-sm); color: var(--fg-3); } .fc-m a { color: var(--fg-2); }
  .fc-a { display: flex; flex-wrap: wrap; gap: 10px 20px; align-items: center; margin-top: 4px; }
  .fc-a .btn[aria-pressed="true"] { background: var(--green-tint); --b-line: var(--green); color: var(--green); }
  .fx-empty { padding: 48px 0; display: grid; gap: 14px; justify-items: start; border-top: 1px solid var(--line); }
  .avail { background: var(--white); }
  .av { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 32px 56px; }
  .av > div { display: grid; gap: 12px; align-content: start; }
  .av-t { width: 100%; border-collapse: collapse; font-size: var(--t-sm); }
  .av-t th, .av-t td { text-align: left; padding: 14px 12px 14px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .av-t thead th { color: var(--fg-3); font-weight: 600; }
  .av-t .n { text-align: right; }
  @media (max-width: 1000px) { .fx, .av { grid-template-columns: 1fr; } .fx-filters { position: static; max-height: none; } .fc { grid-template-columns: 1fr; }
    .fx-groups { display: flex; flex-wrap: nowrap; overflow-x: auto; gap: 8px; } .gq { position: relative; border: 1px solid var(--line); border-radius: 99px; padding: 8px 14px; white-space: nowrap; flex: none; } .gq input { position: absolute; opacity: 0; } .gq:has(input:checked) { background: var(--ink); color: #fff; } .gq:has(input:focus-visible) { outline: 2px solid var(--focus); } }
</style>

<script>
  import { wireAddButtons } from '../scripts/add-buttons';
  import { track } from '../integrations/index';
  const form = document.querySelector<HTMLFormElement>('.fx-filters')!;
  const cards = [...document.querySelectorAll<HTMLLIElement>('.fc')];
  const count = document.querySelector('[data-count]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const q0 = new URLSearchParams(location.search);
  (form.elements.namedItem('q') as HTMLInputElement).value = q0.get('q') || '';
  for (const k of ['role', 'domain', 'status']) if (q0.get(k)) (form.elements.namedItem(k) as HTMLSelectElement).value = q0.get(k)!;
  if (q0.get('group')) { const r = form.querySelector<HTMLInputElement>(`input[name="group"][value="${q0.get('group')}"]`); if (r) r.checked = true; }
  let tm: number | undefined;
  function apply() {
    const fd = new FormData(form); const q = String(fd.get('q') || '').trim().toLowerCase(); const role = String(fd.get('role') || ''); const st = String(fd.get('status') || ''); const g = String(fd.get('group') || ''); const dm = String(fd.get('domain') || '');
    let n = 0;
    cards.forEach((c) => { const ok = (!q || q.split(/\s+/).every((w) => c.dataset.text!.includes(w))) && (!role || c.dataset.roles!.split(' ').includes(role)) && (!st || c.dataset.status === st) && (!g || c.dataset.group === g) && (!dm || c.dataset.domain!.split(' ').includes(dm)); c.hidden = !ok; if (ok) n++; });
    count.textContent = `${n} of ${cards.length} capabilities`; empty.hidden = n > 0;
    const p = new URLSearchParams(); if (q) p.set('q', q); if (role) p.set('role', role); if (g) p.set('group', g); if (dm) p.set('domain', dm); if (st) p.set('status', st);
    history.replaceState(null, '', (p.toString() ? `?${p}` : location.pathname) + location.hash);
    clearTimeout(tm); if (q) tm = window.setTimeout(() => track('feature_search', { results: n }), 800);
  }
  form.addEventListener('input', apply); form.addEventListener('change', apply);
  document.querySelector('[data-clear]')!.addEventListener('click', () => { form.reset(); apply(); });
  apply(); wireAddButtons();
</script>
