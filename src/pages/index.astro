---
import Base from '../layouts/Base.astro';
import Story from '../components/Story.astro';
import DomainVisual from '../components/DomainVisual.astro';
import MiniSim from '../components/MiniSim.astro';
import AppShowcase from '../components/AppShowcase.astro';
import { ROLES } from '../content/apps';
import { DOMAINS, SHARED } from '../content/domains';
import { capabilityById } from '../content/capabilities';
import { FAQS } from '../content/site';
import { MANAGE, MODEL, FOCUS } from '../lib/quick-setup';
const models = [
  { t: 'Service providers', d: 'You maintain equipment for customers under contract. Coverage, response clocks, quotations and proof of work decide whether you get paid.', l: '/industries/hvac-refrigeration' },
  { t: 'Property and facilities managers', d: 'You run buildings and coordinate providers. Residents, owners and contractors each need their own view of the same job.', l: '/industries/property-management' },
  { t: 'In-house engineering teams', d: 'You look after your own estate. Planned work, compliance, parts and asset decisions sit with one team.', l: '/industries/facilities-maintenance' },
];
const layers = [
  { id: 'evidence', t: 'Evidence', d: 'Before-and-after readings, photos, sign-off and who did what, kept on the asset’s history.', ex: 'Valve 98% · supply 14.1 °C · confirmed 15:44' },
  { id: 'action', t: 'Action', d: 'A work order is drafted, a technician suggested with reasons, an update drafted. A person confirms.', ex: 'Suggest Rami S. · skill, 18 min, part in van' },
  { id: 'rule', t: 'Rule', d: 'Your configured rules decide priority, response time and when approval is needed.', ex: 'Valve deviation over 50% for 10 min → priority 2' },
  { id: 'context', t: 'Context', d: 'The asset, its location, contract, warranty, history and what’s booked in the room.', ex: 'Covered · 4 h · out of warranty · meeting 16:00' },
  { id: 'signal', t: 'Signal', d: 'A reading, an alarm, a resident’s message or an inspection finding. This is how information enters.', ex: 'Supply-air sensor 21.6 °C, design 14 °C' },
];
---
<Base title="Tessaro" description="One intelligence across your spaces, assets and service operations: facilities, maintenance, field service and asset management on one record." current="home">
  <Fragment slot="head">
    <link rel="preload" as="image" href="/story/v4/e1p-900.webp" media="(max-aspect-ratio: 5/6)" fetchpriority="high" />
    <link rel="preload" as="image" imagesrcset="/story/v4/e1-1024.webp 1024w, /story/v4/e1-1920.webp 1920w" imagesizes="100vw" media="(min-aspect-ratio: 5/6)" fetchpriority="high" />
  </Fragment>
  <Story />

  <!-- 3. The four domains -->
  <section class="section dom" aria-labelledby="dom-t">
    <div class="wrap">
      <div class="dom-head">
        <p class="eyebrow">The platform</p>
        <h2 id="dom-t">Four ways of looking after a building, on one record.</h2>
        <p class="lead">Facilities teams think in spaces, maintenance teams in schedules, service teams in visits, asset owners in lifecycles. Tessaro keeps them on the same asset, the same work and the same evidence.</p>
      </div>
      <div class="dom-grid" data-dom>
        <div class="dom-list" role="tablist" aria-label="Platform domains" aria-orientation="vertical">
          {DOMAINS.map((d, i) => (
            <button role="tab" id={`dt-${d.id}`} aria-controls={`dp-${d.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-d={d.id} class="dom-tab">
              <span class="dom-n">{d.name}</span><span class="dom-a">{d.acronym}</span>
              <span class="dom-l">{d.line}</span>
            </button>
          ))}
        </div>
        <div class="dom-vis"><DomainVisual /></div>
        {DOMAINS.map((d, i) => (
          <div role="tabpanel" id={`dp-${d.id}`} aria-labelledby={`dt-${d.id}`} class="dom-panel" hidden={i !== 0}>
            <p class="dom-q">{d.question}</p>
            <p>{d.body}</p>
            <p class="dom-c">{d.covers.map((c) => capabilityById[c]?.name).filter(Boolean).slice(0, 6).join(' · ')}</p>
            <a class="link" href={`/platform/${d.id}`}>{d.name} in detail</a>
          </div>
        ))}
      </div>
      <div class="shared">
        <h3 class="h4">What all four share</h3>
        <ul role="list">{SHARED.map((s) => <li><b>{s.name}</b><span>{s.text}</span></li>)}</ul>
      </div>
    </div>
  </section>

  <!-- 3b. The apps people outside the office use -->
  <section class="section apps" id="apps" aria-labelledby="apps-t">
    <div class="wrap">
      <div class="apps-head">
        <p class="eyebrow">The apps</p>
        <h2 id="apps-t">Connected from the customer to the field.</h2>
        <p class="lead">The person who reports a problem and the technician who fixes it each have an app, and both work on the same record the office sees. Business customers follow and approve the work in their own portal.</p>
      </div>
      <AppShowcase uid="home-apps" layout="pair" roles={[ROLES.requester, ROLES.technician, ROLES.portal]} />
      <div class="apps-more"><a class="link" href="/platform/field-service#technician-app">The technician app in field service</a><a class="link" href="/platform/stakeholders#customer-apps">Requester app and customer portal</a></div>
    </div>
  </section>

  <!-- 4. Scale and operating models -->
  <section class="section scale" aria-labelledby="scale-t">
    <div class="wrap">
      <div class="scale-head">
        <h2 id="scale-t">From one room to a portfolio.</h2>
        <p class="lead">The fault you followed is one example. The same structure holds for a single site with ten technicians and for a region of buildings with contractors, owners and residents.</p>
      </div>
      <ol class="models" role="list">
        {models.map((m, i) => (
          <li><span class="mi">{String(i + 1).padStart(2, '0')}</span><h3>{m.t}</h3><p>{m.d}</p><a class="link" href={m.l}>How it works for you</a></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 5. Scenarios (preserved) -->
  <section class="section sim" aria-labelledby="sim-t">
    <div class="wrap sim-grid">
      <div class="sim-copy">
        <p class="eyebrow">Scenarios</p>
        <h2 id="sim-t">Change one thing and watch the work reroute.</h2>
        <p class="lead">Take a technician off shift or lower an approval limit. The outcome is recalculated from the same rules the product uses. Six scenarios, from a building alarm to an owner’s approval.</p>
        <div class="row"><a class="btn btn-primary" href="/simulator">Open the scenario simulator</a><a class="btn btn-quiet" href="/simulator?scenario=bms-alarm">Start with a building alarm</a></div>
      </div>
      <MiniSim />
    </div>
  </section>

  <!-- 6. Configuration, simply -->
  <section class="section qs" aria-labelledby="qs-t" data-qs>
    <div class="wrap">
      <div class="qs-head">
        <h2 id="qs-t">Shape it around your work.</h2>
        <p class="lead">Three choices are enough to see the setup they imply. Adjust the details later; nothing here is final until it passes setup review.</p>
      </div>
      <div class="qs-grid">
        <form class="qs-form" onsubmit="return false">
          <fieldset><legend>What do you manage?</legend>
            {Object.entries(MANAGE).map(([k, v], i) => <label class="opt"><input type="radio" name="manage" value={k} checked={i === 0} /><span><b>{v.label}</b><small>{v.note}</small></span></label>)}
          </fieldset>
          <fieldset><legend>How is your operation organised?</legend>
            {Object.entries(MODEL).map(([k, v], i) => <label class="opt"><input type="radio" name="model" value={k} checked={i === 1} /><span><b>{v.label}</b><small>{v.note}</small></span></label>)}
          </fieldset>
          <fieldset><legend>What do you want to improve first?</legend>
            {Object.entries(FOCUS).map(([k, v], i) => <label class="opt"><input type="radio" name="focus" value={k} checked={i === 0} /><span><b>{v.label}</b><small>{v.note}</small></span></label>)}
          </fieldset>
        </form>
        <div class="qs-prev panel" aria-live="polite">
          <p class="qs-k">Your starting setup</p>
          <p class="qs-t" data-qs-template></p>
          <div class="qs-doms" data-qs-doms></div>
          <dl class="qs-dl">
            <div><dt>People</dt><dd data-qs="people"></dd></div>
            <div><dt>Work</dt><dd data-qs="work"></dd></div>
            <div><dt>Assets</dt><dd data-qs="assets"></dd></div>
            <div><dt>Communication</dt><dd data-qs="communication"></dd></div>
            <div><dt>Oversight</dt><dd data-qs="oversight"></dd></div>
          </dl>
          <div class="row"><a class="btn btn-primary" href="/configurator" data-qs-go>Adjust details</a><button class="btn btn-quiet" type="button" data-qs-save>Save to my setup</button></div>
          <p class="xs muted" data-qs-saved aria-live="polite"></p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. How the intelligence works (layers) -->
  <section class="section lay" aria-labelledby="lay-t">
    <div class="wrap lay-grid">
      <div class="lay-copy">
        <p class="eyebrow">How the intelligence works</p>
        <h2 id="lay-t">It pays attention, checks what matters, and moves the work.</h2>
        <p class="lead">Every suggestion shows the signal it used, the context it checked and the rule that applied. People confirm anything that commits money, a person’s time or a message to a customer.</p>
        <ol class="lay-list" role="list" data-lay-list>
          {[...layers].reverse().map((l, i) => <li><button type="button" data-lay={l.id} aria-pressed={i === 0 ? 'true' : 'false'}><b>{l.t}</b><span>{l.d}</span></button></li>)}
        </ol>
        <p class="small muted">Suggestions, drafted messages and rule-based routing are designed. Coordination across many jobs without a person in the loop is a proposed direction, not a current capability.</p>
      </div>
      <div class="lay-vis" aria-hidden="true" data-lay-vis>
        {layers.map((l, i) => <div class="plane" data-plane={l.id} style={`--i:${i}`}><span class="pl-t">{l.t}</span><span class="pl-ex">{l.ex}</span></div>)}
      </div>
    </div>
  </section>

  <!-- 8. Trust and implementation -->
  <section class="section trust" aria-labelledby="trust-t">
    <div class="wrap">
      <h2 id="trust-t" class="trust-h">What you can rely on.</h2>
      <div class="orow"><h3 class="h4">Where it stands</h3><p>Tessaro 2.0 is designed end to end, with 256 clickable screens across the office, technician, resident, portal and WhatsApp experiences, and is preparing its first pilot release. Every capability on this site says whether it is designed, in pilot or proposed. <a class="link" href="/features#availability">See what exists today</a></p></div>
      <div class="orow"><h3 class="h4">Control</h3><p>Roles and permissions per site and customer, an audit log of every change, and support access only through grants you approve and can revoke.</p></div>
      <div class="orow"><h3 class="h4">Implementation</h3><p>Start from an industry template, import sites and assets from spreadsheets, and publish configuration only after it passes validation. Guided setup is available if you’d rather we do it.</p></div>
      <div class="orow"><h3 class="h4">Help from people</h3><p>Setup guides, a searchable help center and a team you can reach by email, phone or WhatsApp. <a class="link" href="/support">Contact support</a></p></div>
    </div>
  </section>

  <!-- 9. Start -->
  <section class="section start" aria-labelledby="start-t">
    <div class="wrap start-grid">
      <h2 id="start-t">Two ways to start.</h2>
      <div class="path">
        <h3>See it with your work</h3>
        <p>A 45-minute walkthrough built around a scenario you choose, with your saved setup already loaded.</p>
        <a class="btn btn-primary" href="/demo">Book a demo</a>
      </div>
      <div class="path">
        <h3>Set it up yourself</h3>
        <p>A trial workspace from your configuration, with an activation checklist. Nothing is charged during the trial.</p>
        <a class="btn" href="/trial">Start a trial</a>
      </div>
    </div>
  </section>

  <!-- 10. Questions -->
  <section class="section faq" aria-labelledby="faq-t">
    <div class="wrap faq-grid">
      <div><h2 id="faq-t" class="h3">Questions people ask first</h2><p class="muted small">More in the <a class="link" href="/help">help center</a>.</p></div>
      <div class="faq-list">{FAQS.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
    </div>
  </section>
</Base>

<style>
  .eyebrow { margin-bottom: 18px; }
  /* Domains */
  .dom { background: var(--white); }
  .dom-head { max-width: 860px; margin-bottom: 72px; display: grid; gap: 20px; }
  .dom-head .eyebrow { margin: 0; }
  .dom-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); grid-template-areas: "list vis" "panel vis"; gap: 8px 72px; align-items: start; }
  .dom-list { grid-area: list; display: grid; border-top: 1px solid var(--line); }
  .dom-tab { appearance: none; background: none; border: 0; border-bottom: 1px solid var(--line); text-align: left; padding: 20px 0; display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; cursor: pointer; color: var(--fg-2); transition: color var(--d-fast) ease; }
  .dom-n { font-family: var(--font-display); font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.1rem); letter-spacing: -0.03em; font-weight: 520; line-height: 1.1; }
  .dom-a { font-size: var(--t-sm); font-weight: 600; align-self: center; letter-spacing: .04em; }
  .dom-l { grid-column: 1 / -1; font-size: var(--t-sm); max-height: 0; overflow: hidden; opacity: 0; transition: max-height var(--d-panel) var(--ease-out), opacity var(--d-panel) ease; }
  .dom-tab:hover { color: var(--fg); }
  .dom-tab[aria-selected="true"] { color: var(--fg); }
  .dom-tab[aria-selected="true"] .dom-a { color: var(--green); }
  .dom-tab[aria-selected="true"] .dom-l { max-height: 4em; opacity: 1; color: var(--fg-2); }
  .dom-vis { grid-area: vis; position: sticky; top: calc(var(--hdr-h) + 24px); background: var(--chalk); border-radius: var(--r-lg); padding: clamp(16px, 2.4vw, 36px); }
  .dom-panel { grid-area: panel; display: grid; gap: 12px; padding-top: 24px; max-width: 52ch; }
  .dom-q { font-family: var(--font-display); font-size: 1.25rem; letter-spacing: -0.02em; }
  .dom-c { font-size: var(--t-sm); color: var(--fg-2); }
  .shared { margin-top: 96px; display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: 24px 48px; border-top: 1px solid var(--line); padding-top: 32px; }
  .shared ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px 32px; margin: 0; }
  .shared li { display: grid; gap: 6px; } .shared li span { color: var(--fg-2); font-size: var(--t-sm); }

  /* Scale */
  .scale-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px 72px; align-items: end; margin-bottom: 72px; }
  .models { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px; margin: 0; }
  .models li { display: grid; gap: 14px; align-content: start; padding-top: 24px; border-top: 2px solid var(--ink); }
  .mi { font-size: var(--t-sm); font-weight: 600; color: var(--fg-3); font-variant-numeric: tabular-nums; }
  .models p { color: var(--fg-2); }
  .models .link { justify-self: start; }

  /* Simulator */
  .apps { background: var(--chalk); }
  .apps-head { display: grid; gap: 18px; max-width: 760px; margin-bottom: 56px; } .apps-head .eyebrow { margin: 0; }
  .apps-more { display: flex; flex-wrap: wrap; gap: 12px 28px; margin-top: 32px; padding-top: 20px; border-top: 1px solid var(--line); }
  .sim { background: var(--white); }
  .sim-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 72px; align-items: center; }
  .sim-copy { display: grid; gap: 22px; } .sim-copy .eyebrow { margin: 0; }

  /* Quick setup */
  .qs-head { max-width: 760px; display: grid; gap: 20px; margin-bottom: 56px; }
  .qs-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 56px; align-items: start; }
  .qs-form { display: grid; gap: 36px; }
  .qs-form fieldset { border: 0; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 10px; }
  .qs-form legend { font-family: var(--font-display); font-size: 1.35rem; letter-spacing: -0.02em; margin-bottom: 14px; padding: 0; }
  .opt { position: relative; display: block; cursor: pointer; }
  .opt input { position: absolute; opacity: 0; }
  .opt > span { display: grid; gap: 4px; height: 100%; padding: 16px 16px 18px; border-radius: var(--r-md); border: 1px solid var(--line); background: var(--white); transition: border-color var(--d-fast) ease, background-color var(--d-fast) ease, transform var(--d-press) var(--ease-out); }
  .opt:hover > span { border-color: var(--fg-3); }
  .opt:active > span { transform: scale(.985); }
  .opt input:checked + span { border-color: var(--ink); box-shadow: inset 0 0 0 1px var(--ink); }
  .opt input:focus-visible + span { outline: 2px solid var(--focus); outline-offset: 2px; }
  .opt b { font-weight: 600; } .opt small { color: var(--fg-2); font-size: var(--t-sm); line-height: 1.4; }
  .qs-prev { position: sticky; top: calc(var(--hdr-h) + 24px); padding: 28px; display: grid; gap: 18px; }
  .qs-k { font-size: var(--t-sm); color: var(--fg-3); font-weight: 600; }
  .qs-t { font-family: var(--font-display); font-size: 1.75rem; letter-spacing: -0.03em; line-height: 1.1; margin-top: -10px; }
  .qs-doms { display: flex; flex-wrap: wrap; gap: 6px; }
  .qs-doms :global(span) { font-size: var(--t-sm); padding: 4px 10px; border-radius: 99px; border: 1px solid var(--line); color: var(--fg-2); transition: all var(--d-fast) ease; }
  .qs-doms :global(span.lead) { border-color: var(--green); background: var(--green-tint); color: var(--green); font-weight: 600; }
  .qs-dl { display: grid; gap: 0; margin: 0; border-top: 1px solid var(--line); }
  .qs-dl div { display: grid; grid-template-columns: 120px 1fr; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: var(--t-sm); }
  .qs-dl dt { color: var(--fg-3); } .qs-dl dd { margin: 0; }
  .qs-dl dd.changed { animation: flash 700ms var(--ease-out); }
  @keyframes flash { from { background: var(--green-tint); } to { background: transparent; } }

  /* Layers */
  .lay { background: #E7EAE5; overflow: hidden; }
  .lay-grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 64px; align-items: center; }
  .lay-copy { display: grid; gap: 22px; } .lay-copy .eyebrow { margin: 0; }
  .lay-list { margin: 8px 0; display: grid; border-top: 1px solid var(--line-strong); }
  .lay-list button { width: 100%; text-align: left; background: none; border: 0; border-bottom: 1px solid var(--line-strong); padding: 14px 0; display: grid; grid-template-columns: 120px 1fr; gap: 16px; cursor: pointer; color: var(--fg-2); }
  .lay-list button b { color: var(--fg); font-weight: 600; }
  .lay-list button[aria-pressed="true"] b { color: var(--green); }
  .lay-list button[aria-pressed="true"] { color: var(--fg); }
  .lay-vis { position: relative; height: 520px; perspective: 1600px; }
  .plane { position: absolute; left: 50%; top: 50%; width: 360px; height: 220px; margin: -110px 0 0 -180px; border-radius: 14px; background: linear-gradient(160deg, rgba(255,255,255,.92), rgba(255,255,255,.62)); border: 1px solid rgba(32,37,34,.16); box-shadow: 0 30px 50px -30px rgba(32,37,34,.45), inset 0 1px 0 rgba(255,255,255,.9); backdrop-filter: blur(6px); transform: rotateX(58deg) rotateZ(-38deg) translateZ(calc((2 - var(--i)) * 58px)); transition: transform 520ms var(--ease-out), background-color 300ms ease, opacity 300ms ease; display: flex; flex-direction: column; justify-content: flex-end; padding: 18px 20px; }
  .pl-t { font-family: var(--font-display); font-size: 1.15rem; font-weight: 560; letter-spacing: -0.02em; }
  .pl-ex { font-size: 13px; color: var(--fg-2); }
  .plane[data-plane="signal"] { background: linear-gradient(160deg, rgba(233, 160, 90, .38), rgba(255,255,255,.55)); }
  .plane.on { border-color: var(--green); background: linear-gradient(160deg, rgba(36, 91, 70, .28), rgba(255,255,255,.8)); transform: rotateX(58deg) rotateZ(-38deg) translateZ(calc((2 - var(--i)) * 58px + 36px)) translateY(-14px); }
  .lay-vis.focused .plane:not(.on) { opacity: .72; }
  .plane:not(.on) .pl-ex { opacity: 0; }

  /* Trust */
  .trust { background: var(--white); }
  .trust-h { margin-bottom: 48px; }
  .trust .orow p { color: var(--fg-2); max-width: 70ch; }

  /* Start */
  .start-grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 4fr) minmax(0, 4fr); gap: 48px; align-items: start; }
  .path { display: grid; gap: 14px; justify-items: start; padding-top: 22px; border-top: 2px solid var(--ink); }
  .path p { color: var(--fg-2); }

  /* FAQ */
  .faq { background: var(--white); }
  .faq-grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 48px; }
  .faq-list details { border-top: 1px solid var(--line); }
  .faq-list details:last-child { border-bottom: 1px solid var(--line); }
  .faq-list summary { list-style: none; cursor: pointer; padding: 20px 40px 20px 0; font-weight: 600; font-size: 1.0625rem; position: relative; }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary::after { content: ""; position: absolute; right: 6px; top: 26px; width: 10px; height: 10px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(45deg); transition: transform var(--d-fast) var(--ease-out); }
  .faq-list details[open] summary::after { transform: translateY(4px) rotate(225deg); }
  .faq-list details p { padding: 0 0 22px; color: var(--fg-2); max-width: 68ch; }

  @media (max-width: 1000px) {
    .dom-grid { grid-template-columns: 1fr; grid-template-areas: "vis" "list" "panel"; gap: 24px; }
    .dom-vis { position: relative; top: 0; }
    .shared, .scale-head, .sim-grid, .qs-grid, .lay-grid, .faq-grid, .start-grid { grid-template-columns: 1fr; }
    .shared ul { grid-template-columns: 1fr 1fr; }
    .models { grid-template-columns: 1fr; gap: 32px; }
    .qs-prev { position: relative; top: 0; }
    .lay-vis { height: 420px; }
  }
  @media (max-width: 600px) {
    .shared ul { grid-template-columns: 1fr; }
    .lay-vis { height: 340px; transform: scale(.78); }
    .lay-list button { grid-template-columns: 1fr; gap: 4px; }
    .qs-dl div { grid-template-columns: 1fr; gap: 2px; }
  }
</style>

<script>
  import { derive, type Choices } from '../lib/quick-setup';
  import { update, load } from '../lib/setup-store';
  import { auth, track } from '../integrations/index';
  import { DOMAINS } from '../content/domains';

  // Domains: tabs drive the shared drawing
  const dom = document.querySelector<HTMLElement>('[data-dom]')!;
  const tabs = [...dom.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  const svg = dom.querySelector<SVGElement>('[data-dv]')!;
  const layers = [...svg.querySelectorAll<SVGGElement>('.dv-l')];
  function select(id: string, focus = false) {
    tabs.forEach((t) => { const on = t.dataset.d === id; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on; if (on && focus) t.focus(); });
    layers.forEach((l) => l.classList.toggle('on', l.dataset.layer === id));
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t.dataset.d!));
    t.addEventListener('pointerenter', () => layers.forEach((l) => l.classList.toggle('on', l.dataset.layer === t.dataset.d)));
    t.addEventListener('keydown', (e) => { const d = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0; if (d) { e.preventDefault(); select(tabs[(i + d + tabs.length) % tabs.length].dataset.d!, true); } });
  });
  dom.querySelector('.dom-list')!.addEventListener('pointerleave', () => select(tabs.find((t) => t.getAttribute('aria-selected') === 'true')!.dataset.d!));
  select(DOMAINS[0].id);

  // Quick setup preview
  const qs = document.querySelector<HTMLElement>('[data-qs]')!;
  const form = qs.querySelector('form')!;
  const NAMES: Record<string, string> = Object.fromEntries(DOMAINS.map((d) => [d.id, d.name]));
  let prev: Record<string, string> = {};
  const choices = (): Choices => { const fd = new FormData(form); return { manage: fd.get('manage') as any, model: fd.get('model') as any, focus: fd.get('focus') as any }; };
  function paint() {
    const c = choices(); const d = derive(c);
    qs.querySelector('[data-qs-template]')!.textContent = `${d.template} template`;
    qs.querySelector('[data-qs-doms]')!.innerHTML = d.domains.map((x) => `<span class="${x.weight}">${NAMES[x.id]}</span>`).join('');
    (['people', 'work', 'assets', 'communication', 'oversight'] as const).forEach((k) => {
      const el = qs.querySelector<HTMLElement>(`[data-qs="${k}"]`)!; const v = d[k].join(' · ');
      if (prev[k] && prev[k] !== v) { el.classList.remove('changed'); void el.offsetWidth; el.classList.add('changed'); }
      el.textContent = v; prev[k] = v;
    });
    qs.querySelector<HTMLAnchorElement>('[data-qs-go]')!.href = `/configurator?manage=${c.manage}&model=${c.model}&focus=${c.focus}`;
  }
  form.addEventListener('change', () => { paint(); track('quick_setup_changed', {}); });
  qs.querySelector('[data-qs-save]')!.addEventListener('click', () => {
    const c = choices(); const d = derive(c);
    update((s) => { s.industry = d.industry; d.capabilities.forEach((id) => { if (!s.capabilities.includes(id)) s.capabilities.push(id); }); s.config = { step: 0, values: { ...(s.config?.values || {}), ...d.patch, start: c }, updatedAt: new Date().toISOString() }; });
    auth.persistAccountCopy(); track('quick_setup_saved', {});
    qs.querySelector('[data-qs-saved]')!.textContent = `Saved ${load().capabilities.length} capabilities and your starting choices${auth.current() ? ' to your account' : ' on this device'}.`;
  });
  paint();

  // Layers
  const vis = document.querySelector<HTMLElement>('[data-lay-vis]')!;
  const lbtns = [...document.querySelectorAll<HTMLButtonElement>('[data-lay]')];
  const setLay = (id: string) => { lbtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.lay === id))); vis.querySelectorAll<HTMLElement>('.plane').forEach((p) => p.classList.toggle('on', p.dataset.plane === id)); vis.classList.add('focused'); };
  lbtns.forEach((b) => { b.addEventListener('click', () => setLay(b.dataset.lay!)); b.addEventListener('pointerenter', () => setLay(b.dataset.lay!)); b.addEventListener('focus', () => setLay(b.dataset.lay!)); });
  setLay('signal');
</script>
